# Origin ERP yang menyediakan konten situs & menerima pesan formulir (tanpa garis miring di akhir).
# Contoh: VITE_CMS_URL=https://erp.karyaciptasolusi.com
# Kosongkan untuk memakai konten bawaan di src/data/siteDefaults.ts dan formulir via WhatsApp.
# Catatan: origin ini harus diizinkan di CSP connect-src (vercel.json & public/_headers).
VITE_CMS_URL=
