{
  "name": "@kcs/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:setup": "node scripts/db-setup.mjs",
    "db:migrate": "prisma migrate deploy && node scripts/db-security.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "helmet": "^8.3.0",
    "imapflow": "2.9.1",
    "mailparser": "3.12.4",
    "nodemailer": "^10.4.0",
    "pdfkit": "^0.15.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.1.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mailparser": "3.9.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^7.0.12",
    "@types/pdfkit": "^0.13.9",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "5.8"
  }
}
