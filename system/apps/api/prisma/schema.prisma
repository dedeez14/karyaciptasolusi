// =============================================================================
// KCS ERP - Database schema
// Conventions:
//   * UUID primary keys, table names in snake_case via @@map
//   * company-scoped tables carry companyId (multi company) and optional branchId
//   * soft delete with deletedAt; audit columns createdById / updatedById
//   * money Decimal(18,2), quantity Decimal(18,4), rate Decimal(9,4)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Enums (only true domain invariants live here; business lists are LookupValue)
// ----------------------------------------------------------------------------

enum DataScope {
  ALL
  COMPANY
  BRANCH
  OWN
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum ProductType {
  STOCK
  SERVICE
  CONSUMABLE
}

enum DocStatus {
  DRAFT
  CONFIRMED
  PARTIAL
  COMPLETED
  CANCELLED
}

enum PaymentDirection {
  IN
  OUT
}

enum JournalStatus {
  DRAFT
  POSTED
  VOID
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FileSource {
  UPLOAD
  GENERATED
  EXPORT
}

// ----------------------------------------------------------------------------
// Platform: tenancy, identity, access control
// ----------------------------------------------------------------------------

model Company {
  id           String    @id @default(uuid()) @db.Uuid
  code         String    @unique @db.VarChar(20)
  name         String    @db.VarChar(150)
  legalName    String?   @db.VarChar(200)
  taxId        String?   @db.VarChar(255) // encrypted
  email        String?   @db.VarChar(150)
  phone        String?   @db.VarChar(50)
  website      String?   @db.VarChar(150)
  address      String?
  city         String?   @db.VarChar(100)
  countryCode  String?   @db.VarChar(3)
  currencyCode String    @default("IDR") @db.VarChar(3)
  logoFileId   String?   @db.Uuid
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  branches    Branch[]
  assignments UserAssignment[]

  @@map("companies")
}

model Branch {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  code         String    @db.VarChar(20)
  name         String    @db.VarChar(150)
  email        String?   @db.VarChar(150)
  phone        String?   @db.VarChar(50)
  address      String?
  city         String?   @db.VarChar(100)
  isHeadOffice Boolean   @default(false)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  company     Company          @relation(fields: [companyId], references: [id])
  assignments UserAssignment[]
  warehouses  Warehouse[]

  @@unique([companyId, code])
  @@map("branches")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  username           String    @unique @db.VarChar(50)
  email              String    @unique @db.VarChar(150)
  fullName           String    @db.VarChar(150)
  phone              String?   @db.VarChar(255) // encrypted
  passwordHash       String    @db.VarChar(255)
  isSuperAdmin       Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?   @db.VarChar(64)
  passwordChangedAt  DateTime?
  /// two-factor sign-in (TOTP): secret encrypted at rest, recovery codes stored as SHA-256 hashes
  mfaSecret          String?   @db.VarChar(255)
  mfaPendingSecret   String?   @db.VarChar(255)
  mfaEnabledAt       DateTime?
  /// last accepted 30 s time step (a code can only be used once)
  mfaLastStep        Int?
  mfaRecoveryCodes   String?
  defaultCompanyId   String?   @db.Uuid
  defaultBranchId    String?   @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedAt          DateTime?
  /// the user's own signature image (encrypted PNG in storage), placed on documents only when signatureEnabled
  signatureKey       String?   @db.VarChar(255)
  signatureEnabled   Boolean   @default(false)
  signatureUpdatedAt DateTime?

  assignments UserAssignment[]
  sessions    Session[]
  employee    Employee?

  @@map("users")
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String?   @db.Uuid // null = global role template
  code        String    @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String?
  dataScope   DataScope @default(BRANCH)
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  permissions RolePermission[]
  assignments UserAssignment[]

  @@unique([companyId, code])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100) // e.g. sales.invoice.create
  module      String  @db.VarChar(50)
  resource    String  @db.VarChar(80)
  action      String  @db.VarChar(30)
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// ACL: which company / branch a user can access and with which role.
/// branchId null = all branches of the company.
model UserAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  companyId String   @db.Uuid
  branchId  String?  @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  branch  Branch? @relation(fields: [branchId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, companyId, branchId, roleId])
  @@index([userId])
  @@map("user_assignments")
}

/// Refresh-token sessions (rotating, hashed, family based reuse detection)
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  familyId   String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  userAgent  String?   @db.VarChar(255)
  ip         String?   @db.VarChar(64)
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?   @db.Uuid
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Menu {
  id             String   @id @default(uuid()) @db.Uuid
  parentId       String?  @db.Uuid
  code           String   @unique @db.VarChar(80)
  label          String   @db.VarChar(100)
  icon           String?  @db.VarChar(50)
  path           String?  @db.VarChar(200)
  permissionCode String?  @db.VarChar(100)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   Menu?  @relation("MenuTree", fields: [parentId], references: [id])
  children Menu[] @relation("MenuTree")

  @@index([parentId])
  @@map("menus")
}

/// Key/value settings. companyId null = global default. Secrets are encrypted.
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @db.Uuid
  group       String   @db.VarChar(50)
  key         String   @db.VarChar(100)
  value       String?
  valueType   String   @default("string") @db.VarChar(20) // string | number | boolean | json | secret
  label       String?  @db.VarChar(150)
  description String?
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?  @db.Uuid

  @@unique([companyId, key])
  @@map("settings")
}

model NumberSequence {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  code        String   @db.VarChar(30) // document type code e.g. SI, PO
  name        String   @db.VarChar(100)
  prefix      String   @db.VarChar(30) // supports tokens {YYYY} {YY} {MM} {BR}
  padding     Int      @default(5)
  nextNumber  Int      @default(1)
  resetPeriod String   @default("YEARLY") @db.VarChar(10) // NEVER | YEARLY | MONTHLY
  lastPeriod  String?  @db.VarChar(10)
  updatedAt   DateTime @updatedAt

  periods NumberSequencePeriod[]

  @@unique([companyId, code])
  @@map("number_sequences")
}

/// Counter per reset period (month / year), so back- or forward-dated documents never reuse a number
model NumberSequencePeriod {
  sequenceId String @db.Uuid
  period     String @db.VarChar(10)
  nextNumber Int    @default(1)

  sequence NumberSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@id([sequenceId, period])
  @@map("number_sequence_periods")
}

/// Generic lookup lists (gender, religion, lead status, channels, ...) - no hardcode
model LookupValue {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String?   @db.Uuid
  category  String    @db.VarChar(50)
  code      String    @db.VarChar(50)
  name      String    @db.VarChar(100)
  color     String?   @db.VarChar(20)
  sortOrder Int       @default(0)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([companyId, category, code])
  @@index([category])
  @@map("lookup_values")
}

/// Immutable data-change audit trail (append only - enforced by DB trigger)
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  companyId String?  @db.Uuid
  userId    String?  @db.Uuid
  username  String?  @db.VarChar(50)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(64)
  action    String   @db.VarChar(30)
  before    Json?
  after     Json?
  ip        String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(255)
  requestId String?  @db.VarChar(64)
  createdAt DateTime @default(now())
  /// tamper-evident chain: HMAC(prevHash | canonical entry)
  prevHash  String?  @db.VarChar(64)
  hash      String?  @db.VarChar(64)

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// User activity trail (requests, logins, exports, downloads)
model ActivityLog {
  id         BigInt   @id @default(autoincrement())
  companyId  String?  @db.Uuid
  userId     String?  @db.Uuid
  username   String?  @db.VarChar(50)
  action     String   @db.VarChar(80)
  method     String?  @db.VarChar(10)
  path       String?  @db.VarChar(255)
  statusCode Int?
  durationMs Int?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @db.VarChar(255)
  requestId  String?  @db.VarChar(64)
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([userId, createdAt])
  @@map("activity_logs")
}

// ----------------------------------------------------------------------------
// Master data
// ----------------------------------------------------------------------------

model Currency {
  code      String   @id @db.VarChar(3)
  name      String   @db.VarChar(60)
  symbol    String   @db.VarChar(10)
  decimals  Int      @default(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("currencies")
}

model ExchangeRate {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  currencyCode String    @db.VarChar(3)
  date         DateTime  @db.Date
  rate         Decimal   @db.Decimal(18, 6)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  @@unique([companyId, currencyCode, date])
  @@map("exchange_rates")
}

model Country {
  code      String   @id @db.VarChar(3)
  name      String   @db.VarChar(100)
  phoneCode String?  @db.VarChar(10)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("countries")
}

model Uom {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(60)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?
  products    Product[]

  @@unique([companyId, code])
  @@map("uoms")
}

model ProductCategory {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  parentId    String?   @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, code])
  @@map("product_categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  products Product[]

  @@unique([companyId, code])
  @@map("brands")
}

model Tax {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  code              String    @db.VarChar(20)
  name              String    @db.VarChar(100)
  rate              Decimal   @db.Decimal(9, 4)
  /// VAT (PPN on document lines) | WHT (income tax withheld on payments: PPh 23, PPh 4(2), PPh final)
  kind              String    @default("VAT") @db.VarChar(10)
  /// tax base as a fraction of the net price: 11/12 for "DPP nilai lain" (PMK 131/2024), 1/1 otherwise
  baseNumerator     Int       @default(1)
  baseDenominator   Int       @default(1)
  /// Coretax transaction code of a VAT (01 normal, 04 DPP nilai lain, ...)
  trxCode           String?   @db.VarChar(4)
  /// Coretax tax object code of a withholding tax (e.g. 24-104-14)
  objectCode        String?   @db.VarChar(20)
  /// withholding: rate is doubled when the other party has no NPWP / NIK (PPh 23)
  noNpwpSurcharge   Boolean   @default(false)
  salesAccountId    String?   @db.Uuid
  purchaseAccountId String?   @db.Uuid
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime?

  @@unique([companyId, code])
  @@map("taxes")
}

model Product {
  id                  String      @id @default(uuid()) @db.Uuid
  companyId           String      @db.Uuid
  code                String      @db.VarChar(40)
  name                String      @db.VarChar(200)
  type                ProductType @default(STOCK)
  categoryId          String?     @db.Uuid
  brandId             String?     @db.Uuid
  uomId               String?     @db.Uuid
  barcode             String?     @db.VarChar(60)
  description         String?
  salePrice           Decimal     @default(0) @db.Decimal(18, 2)
  purchasePrice       Decimal     @default(0) @db.Decimal(18, 2)
  minStock            Decimal     @default(0) @db.Decimal(18, 4)
  /// reorder planning: order up to this level (0 = order the reorder quantity), quantity per order, usual supplier
  maxStock            Decimal     @default(0) @db.Decimal(18, 4)
  reorderQty          Decimal     @default(0) @db.Decimal(18, 4)
  preferredSupplierId String?     @db.Uuid
  leadTimeDays        Int         @default(0)
  /// batch / lot and expiry tracking (food, medicine, chemicals...): FEFO picking, expiry alerts, recalls
  trackLots           Boolean     @default(false)
  /// days from receipt to expiry, used when a receipt gives no expiry date (0 = none)
  shelfLifeDays       Int         @default(0)
  /// POS: kitchen / bar station that prepares it (KDS routing); empty = handed over at the counter
  posStation          String?     @db.VarChar(30)
  /// warn this many days before a lot expires
  expiryAlertDays     Int         @default(60)
  /// compliance: HS code, country of origin (empty = the supplier's), auxiliary material (bahan penolong, SIINas),
  /// certificates the product must have (halal for food & drink, BPOM, SNI)
  hsCode              String?     @db.VarChar(12)
  originCountry       String?     @db.VarChar(3)
  auxiliaryMaterial   Boolean     @default(false)
  halalRequired       Boolean     @default(false)
  bpomRequired        Boolean     @default(false)
  sniRequired         Boolean     @default(false)
  saleTaxId           String?     @db.Uuid
  purchaseTaxId       String?     @db.Uuid
  incomeAccountId     String?     @db.Uuid
  expenseAccountId    String?     @db.Uuid
  isSellable          Boolean     @default(true)
  isPurchasable       Boolean     @default(true)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  createdById         String?     @db.Uuid
  updatedById         String?     @db.Uuid
  deletedAt           DateTime?

  category ProductCategory? @relation(fields: [categoryId], references: [id])
  brand    Brand?           @relation(fields: [brandId], references: [id])
  uom      Uom?             @relation(fields: [uomId], references: [id])

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("products")
}

model Warehouse {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  branchId    String?   @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  address     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([companyId, code])
  @@map("warehouses")
}

model PaymentTerm {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  days        Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("payment_terms")
}

model PaymentMethod {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("payment_methods")
}

model Bank {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(100)
  swiftCode String?  @db.VarChar(20)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banks")
}

model BankAccount {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  branchId      String?   @db.Uuid
  code          String    @db.VarChar(20)
  name          String    @db.VarChar(100)
  bankId        String?   @db.Uuid
  accountNumber String?   @db.VarChar(255) // encrypted
  accountHolder String?   @db.VarChar(150)
  currencyCode  String    @default("IDR") @db.VarChar(3)
  accountId     String?   @db.Uuid // ledger (COA) account
  isCash        Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  @@unique([companyId, code])
  @@map("bank_accounts")
}

model CustomerGroup {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("customer_groups")
}

model Customer {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(200)
  groupId          String?   @db.Uuid
  contactPerson    String?   @db.VarChar(150)
  email            String?   @db.VarChar(150)
  phone            String?   @db.VarChar(50)
  taxId            String?   @db.VarChar(255) // encrypted
  address          String?
  city             String?   @db.VarChar(100)
  countryCode      String?   @db.VarChar(3)
  paymentTermId    String?   @db.Uuid
  creditLimit      Decimal   @default(0) @db.Decimal(18, 2)
  industryCode     String?   @db.VarChar(50)
  notes            String?
  /// loyalty membership (POS): member number, points balance, consent under UU 27/2022 (PDP)
  memberNo         String?   @db.VarChar(30)
  points           Int       @default(0)
  memberSince      DateTime?
  consentAt        DateTime?
  marketingConsent Boolean   @default(false)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  @@unique([companyId, code])
  @@unique([companyId, memberNo])
  @@index([companyId, name])
  @@map("customers")
}

model SupplierGroup {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("supplier_groups")
}

model Supplier {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  code          String    @db.VarChar(30)
  name          String    @db.VarChar(200)
  groupId       String?   @db.Uuid
  contactPerson String?   @db.VarChar(150)
  email         String?   @db.VarChar(150)
  phone         String?   @db.VarChar(50)
