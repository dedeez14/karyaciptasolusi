// ----------------------------------------------------------------------------
// Lead finder (Google Maps scraper)
// ----------------------------------------------------------------------------

model ScrapeJob {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  code          String    @db.VarChar(30)
  name          String    @db.VarChar(200)
  /// one search per line, e.g. "konveksi di Bandung"
  queries       String
  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  radiusKm      Decimal?  @db.Decimal(8, 2)
  zoom          Int?
  depth         Int       @default(3)
  languageCode  String    @default("id") @db.VarChar(10)
  extractEmails Boolean   @default(true)
  fastMode      Boolean   @default(false)
  statusCode    String    @default("QUEUED") @db.VarChar(20) // lookup SCRAPE_STATUS
  startedAt     DateTime?
  finishedAt    DateTime?
  resultCount   Int       @default(0)
  newCount      Int       @default(0)
  error         String?
  logTail       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  @@unique([companyId, code])
  @@index([companyId, statusCode])
  @@map("scrape_jobs")
}

/// One business found on Google Maps (deduplicated per company by place id / cid)
model MapPlace {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  jobId          String?   @db.Uuid
  /// Google place id or cid - dedupe key
  placeKey       String    @db.VarChar(120)
  query          String?   @db.VarChar(300)
  title          String    @db.VarChar(300)
  category       String?   @db.VarChar(200)
  address        String?
  phone          String?   @db.VarChar(80)
  website        String?   @db.VarChar(500)
  emails         String?   @db.VarChar(1000)
  /// when the website was read for e-mail addresses, and what came out of it
  emailCheckedAt DateTime?
  emailNote      String?   @db.VarChar(200)
  rating         Decimal?  @db.Decimal(3, 2)
  reviewCount    Int?
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  mapsUrl        String?   @db.VarChar(1000)
  businessStatus String?   @db.VarChar(50)
  statusCode     String    @default("NEW") @db.VarChar(20) // lookup MAP_PLACE_STATUS
  leadId         String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, placeKey])
  @@index([companyId, statusCode])
  @@index([jobId])
  @@map("map_places")
}

// ----------------------------------------------------------------------------
// E-mail campaigns (marketing blasts)
// ----------------------------------------------------------------------------

model EmailCampaign {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(200)
  subject          String    @db.VarChar(300)
  /// HTML body with merge tags ({{name}}, {{company}}, ...)
  body             String
  fromName         String?   @db.VarChar(150)
  replyTo          String?   @db.VarChar(150)
  campaignId       String?   @db.Uuid // marketing campaign it belongs to
  /// audience definition: { source: LEADS|CUSTOMERS|MAP_PLACES|MANUAL, filters..., emails? }
  audience         Json
  /// AUTOMATIC: keeps adding new matching contacts and sends to them as they appear
  automatic        Boolean   @default(false)
  statusCode       String    @default("DRAFT") @db.VarChar(20) // lookup EMAIL_CAMPAIGN_STATUS
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  ratePerMinute    Int       @default(20)
  trackOpens       Boolean   @default(false)
  totalCount       Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  openCount        Int       @default(0)
  unsubscribeCount Int       @default(0)
  replyCount       Int       @default(0)
  /// follow-ups are sent in office hours only (Mon-Fri 08:00-17:00, company time zone)
  followUpWeekdays Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  recipients EmailRecipient[]
  steps      EmailCampaignStep[]

  @@unique([companyId, code])
  @@index([companyId, statusCode])
  @@map("email_campaigns")
}

model EmailRecipient {
  id            String    @id @default(uuid()) @db.Uuid
  campaignId    String    @db.Uuid
  companyId     String    @db.Uuid
  email         String    @db.VarChar(200)
  name          String?   @db.VarChar(200)
  /// where the contact came from: LEAD / CUSTOMER / MAP_PLACE / MANUAL
  entityType    String?   @db.VarChar(20)
  entityId      String?   @db.Uuid
  /// merge data snapshot ({ name, company, city, ... })
  data          Json?
  statusCode    String    @default("QUEUED") @db.VarChar(20) // lookup EMAIL_RECIPIENT_STATUS
  /// random token for unsubscribe / open links
  token         String    @db.VarChar(64)
  error         String?   @db.VarChar(500)
  sentAt        DateTime?
  openedAt      DateTime?
  /// last e-mail of the sequence sent to this recipient (0 = the campaign e-mail, 1.. = follow-ups)
  step          Int       @default(0)
  lastSentAt    DateTime?
  /// Message-ID of the last e-mail, so the next follow-up continues the same thread
  lastMessageId String?   @db.VarChar(250)
  /// when the next follow-up is due (null = nothing more to send)
  nextSendAt    DateTime?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@unique([token])
  @@index([campaignId, statusCode])
  @@index([campaignId, nextSendAt])
  @@index([companyId, email])
  @@map("email_recipients")
}

/// Follow-up e-mail of a campaign, sent when the recipient has not replied after the delay
model EmailCampaignStep {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  /// 1 = first follow-up
  position   Int
  /// days after the previous e-mail of the sequence
  delayDays  Int
  /// empty = "Re: <campaign subject>" in the same thread
  subject    String?  @db.VarChar(300)
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, position])
  @@map("email_campaign_steps")
}

/// One sent campaign e-mail (daily limit, thread matching of replies)
model EmailMessage {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  campaignId  String   @db.Uuid
  recipientId String   @db.Uuid
  step        Int      @default(0)
  messageId   String?  @db.VarChar(250)
  sentAt      DateTime @default(now())

  @@index([companyId, sentAt])
  @@index([campaignId, sentAt])
  @@index([messageId])
  @@map("email_messages")
}

/// A reply, automatic reply or bounce found in the mailbox for a campaign e-mail.
/// Only messages that belong to a campaign are stored, and only a short excerpt of them.
model EmailReply {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  campaignId  String?   @db.Uuid
  recipientId String?   @db.Uuid
  kindCode    String    @db.VarChar(20) // lookup EMAIL_REPLY_KIND
  fromEmail   String    @db.VarChar(200)
  fromName    String?   @db.VarChar(200)
  subject     String?   @db.VarChar(300)
  snippet     String?   @db.VarChar(600)
  messageId   String    @db.VarChar(250)
  receivedAt  DateTime
  handledAt   DateTime?
  handledById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@unique([companyId, messageId])
  @@index([companyId, handledAt])
  @@index([campaignId])
  @@map("email_replies")
}

/// Where the reply check stopped in the mailbox of a company
model EmailInboxState {
  companyId     String    @id @db.Uuid
  uidValidity   String?   @db.VarChar(30)
  lastUid       Int       @default(0)
  lastCheckedAt DateTime?
  lastError     String?   @db.VarChar(500)
  lastErrorAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("email_inbox_states")
}

/// Addresses that must never receive marketing e-mail (unsubscribed, bounced, added by hand)
model EmailSuppression {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  email      String   @db.VarChar(200)
  reasonCode String   @db.VarChar(20) // lookup EMAIL_SUPPRESSION_REASON
  note       String?  @db.VarChar(300)
  campaignId String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([companyId, email])
  @@map("email_suppressions")
}

/// One block of the public website (karyaciptasolusi.com): a service, portfolio item, testimonial, FAQ, ...
/// The site reads the published blocks of one company through GET /public/website.
model WebContent {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  /// SERVICE | PORTFOLIO | TESTIMONIAL | FAQ | CLIENT | STAT | REASON | STEP | JOB
  section     String    @db.VarChar(20)
  title       String    @db.VarChar(200)
  subtitle    String?   @db.VarChar(200)
  body        String?
  icon        String?   @db.VarChar(50)
  imageUrl    String?   @db.VarChar(500)
  linkUrl     String?   @db.VarChar(500)
  tags        String?   @db.VarChar(500)
  value       String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, section, sortOrder])
  @@map("web_contents")
}

/// Running announcement shown under the top bar of the application for everyone in the company
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  message     String    @db.VarChar(500)
  /// INFO | SUCCESS | WARNING | URGENT
  tone        String    @default("INFO") @db.VarChar(20)
  linkUrl     String?   @db.VarChar(500)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, isActive])
  @@map("announcements")
}

/// Official company letter (recommendation, statement, assignment...) printed on the letterhead and signed
/// electronically by the system (QR verification)
model CompanyLetter {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  number         String    @db.VarChar(60)
  letterType     String    @db.VarChar(30)
  /// PERSON: signer + person details before the text; PLAIN: the text only (memo, invitation, minutes)
  layout         String    @default("PERSON") @db.VarChar(10)
  letterDate     DateTime  @db.Date
  subject        String    @db.VarChar(200)
  recipient      String?
  personName     String?   @db.VarChar(150)
  /// encrypted
  personIdNumber String?   @db.VarChar(255)
  /// encrypted
  personAddress  String?
  personPosition String?   @db.VarChar(150)
  body           String
  place          String    @db.VarChar(80)
  signerName     String    @db.VarChar(150)
  signerTitle    String    @db.VarChar(100)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  @@unique([companyId, number])
  @@map("company_letters")
}

/// A document text the director saved for reuse in the Document Center
model LetterTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  name        String    @db.VarChar(150)
  letterType  String    @db.VarChar(30)
  layout      String    @default("PERSON") @db.VarChar(10)
  subject     String    @db.VarChar(200)
  recipient   String?
  body        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, letterType])
  @@map("letter_templates")
}

/// Billing milestone (termin) of a client project: invoiced on its own, e.g. 30% down payment, 40% demo, 30% handover
model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  projectId   String    @db.Uuid
  sortOrder   Int       @default(0)
  name        String    @db.VarChar(150)
  percent     Decimal?  @db.Decimal(5, 2)
  amount      Decimal   @db.Decimal(18, 2)
  dueDate     DateTime? @db.Date
  /// when it may be billed, e.g. "Setelah BAST ditandatangani"
  trigger     String?   @db.VarChar(200)
  invoiceId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, projectId])
  @@map("project_milestones")
}

/// UU 27/2022 (PDP): requests from data subjects (access, correction, deletion, ...) and how they were handled
model DataSubjectRequest {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  number         String    @db.VarChar(40)
  /// ACCESS | CORRECTION | DELETION | PORTABILITY | WITHDRAW_CONSENT | OBJECTION | RESTRICTION
  typeCode       String    @db.VarChar(30)
  requesterName  String    @db.VarChar(150)
  requesterEmail String?   @db.VarChar(150)
  /// the record the request is about: LEAD | CUSTOMER | EMPLOYEE | USER | OTHER
  subjectType    String    @db.VarChar(20)
  subjectId      String?   @db.Uuid
  receivedAt     DateTime  @default(now())
  dueAt          DateTime
  /// RECEIVED | VERIFYING | IN_PROGRESS | DONE | REJECTED
  statusCode     String    @default("RECEIVED") @db.VarChar(20)
  details        String?
  response       String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  @@unique([companyId, number])
  @@map("data_subject_requests")
}

/// UU 27/2022 (PDP): personal data breaches; data subjects and the authority are told within 3 x 24 hours
model DataBreach {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  number              String    @db.VarChar(40)
  title               String    @db.VarChar(200)
  discoveredAt        DateTime
  notifyBy            DateTime
  /// what data and whose
  dataCategories      String?
  subjectsAffected    Int?
  cause               String?
  actionsTaken        String?
  /// LOW | MEDIUM | HIGH
  severityCode        String    @default("MEDIUM") @db.VarChar(10)
  /// OPEN | CONTAINED | NOTIFIED | CLOSED
  statusCode          String    @default("OPEN") @db.VarChar(20)
  subjectsNotifiedAt  DateTime?
  authorityNotifiedAt DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?   @db.Uuid
  updatedById         String?   @db.Uuid
  deletedAt           DateTime?

  @@unique([companyId, number])
  @@map("data_breaches")
}

/// Physical stock count (stock opname) of one warehouse; posting creates a confirmed stock adjustment for the differences
model StockCount {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  branchId     String?   @db.Uuid
  number       String    @db.VarChar(40)
  warehouseId  String    @db.Uuid
  countDate    DateTime  @db.Date
  /// COUNTING | POSTED | CANCELLED
  status       String    @default("COUNTING") @db.VarChar(20)
  /// people who counted and witnessed (printed on the berita acara)
  countedBy    String?   @db.VarChar(200)
  witnessedBy  String?   @db.VarChar(200)
  notes        String?
  adjustmentId String?   @db.Uuid
  postedAt     DateTime?
  postedById   String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  lines StockCountLine[]

  @@unique([companyId, number])
  @@map("stock_counts")
}

model StockCountLine {
  id         String    @id @default(uuid()) @db.Uuid
  countId    String    @db.Uuid
  productId  String    @db.Uuid
  /// book quantity when the count started, and when it was posted
  systemQty  Decimal   @db.Decimal(18, 4)
  countedQty Decimal?  @db.Decimal(18, 4)
  /// average cost at posting (values the difference)
  unitCost   Decimal   @default(0) @db.Decimal(18, 4)
  note       String?   @db.VarChar(300)
  countedAt  DateTime?

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
  @@map("stock_count_lines")
}

/// A credit note (sales return) or debit note (purchase return) settling part of an open invoice of the same partner
model CreditApplication {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  creditNoteId String   @db.Uuid
  invoiceId    String   @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  date         DateTime @db.Date
  createdAt    DateTime @default(now())
  createdById  String?  @db.Uuid

  @@index([creditNoteId])
  @@index([invoiceId])
  @@map("credit_applications")
}

/// A batch / lot of a product (nomor bets) with its expiry date
model StockLot {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  productId       String    @db.Uuid
  lotNo           String    @db.VarChar(60)
  expiryDate      DateTime? @db.Date
  manufactureDate DateTime? @db.Date
  notes           String?   @db.VarChar(300)
  /// quality status: RELEASED (usable) | HOLD (waiting for inspection) | REJECTED (failed, see the non-conformance)
  qcStatus        String    @default("RELEASED") @db.VarChar(10)
  createdAt       DateTime  @default(now())

  balances LotBalance[]

  @@unique([companyId, productId, lotNo])
  @@index([companyId, expiryDate])
  @@map("stock_lots")
}

model LotBalance {
  id          String   @id @default(uuid()) @db.Uuid
  lotId       String   @db.Uuid
  warehouseId String   @db.Uuid
  qty         Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt

  lot StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, warehouseId])
  @@map("lot_balances")
}

/// Which lots a document line moved (signed: + in, - out); used for reversal on cancel and for lot tracing / recalls
model LineLot {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  documentId  String   @db.Uuid
  lineId      String   @db.Uuid
  lotId       String   @db.Uuid
  warehouseId String   @db.Uuid
  qty         Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([lotId])
  @@index([lineId])
  @@map("line_lots")
}

/// Destruction of expired / damaged stock (pemusnahan): the stock adjustment plus the itemised berita acara
model StockDisposal {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  number          String   @db.VarChar(40)
  warehouseId     String   @db.Uuid
  date            DateTime @db.Date
  /// EXPIRED | DAMAGED | RECALL | OTHER
  reasonCode      String   @db.VarChar(20)
  method          String?  @db.VarChar(200)
  witnessedBy     String?  @db.VarChar(300)
  /// outside witness, e.g. the account representative of the tax office or a BPOM / Dinkes officer
  externalWitness String?  @db.VarChar(300)
  notes           String?
  adjustmentId    String?  @db.Uuid
  /// snapshot printed on the berita acara: code, name, lot, expiry, qty, unit cost, value
  lines           Json
  totalValue      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  createdById     String?  @db.Uuid

  @@unique([companyId, number])
  @@map("stock_disposals")
}

/// Bill of materials: the components and conversion cost needed to make a batch of a product
model Bom {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  code            String    @db.VarChar(30)
  name            String    @db.VarChar(200)
  /// finished product
  productId       String    @db.Uuid
  /// quantity of the product one batch makes
  outputQty       Decimal   @default(1) @db.Decimal(18, 4)
  /// standard direct labour and production overhead per batch (SAK EP: overhead at normal capacity)
  labourCost      Decimal   @default(0) @db.Decimal(18, 2)
  overheadCost    Decimal   @default(0) @db.Decimal(18, 2)
  isDefault       Boolean   @default(true)
  isActive        Boolean   @default(true)
  /// recipe / kit: selling the product (POS) issues these components instead of the product itself
  backflushOnSale Boolean   @default(false)
  /// STANDARD (quantities per batch) | FORMULA (components in % of the batch weight / volume, scaled to the batch)
  kind            String    @default("STANDARD") @db.VarChar(10)
  /// expected loss of finished units (e.g. 2%): losses above it are abnormal and expensed (SAK EP / PSAK 202)
  normalScrapPct  Decimal   @default(0) @db.Decimal(9, 4)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  deletedAt       DateTime?

  lines      BomLine[]
  operations BomOperation[]
  outputs    BomOutput[]

  @@unique([companyId, code])
  @@index([companyId, productId])
  @@map("boms")
}

model BomLine {
  id           String   @id @default(uuid()) @db.Uuid
  bomId        String   @db.Uuid
  lineNo       Int
  productId    String   @db.Uuid
  /// per batch
  qty          Decimal  @db.Decimal(18, 4)
  /// expected loss in production (added to the quantity issued)
  scrapPct     Decimal  @default(0) @db.Decimal(9, 4)
  /// formula BOMs: share of the batch in percent
  pct          Decimal? @db.Decimal(9, 4)
  /// phantom sub-assembly: not stocked, its own BOM is exploded into the work order
  phantom      Boolean  @default(false)
  /// routing step that consumes it (issued when that step starts); empty = at the start
  operationSeq Int?
  notes        String?  @db.VarChar(300)

  bom Bom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@map("bom_lines")
}

/// Production order: components issued, finished goods received at material + labour + overhead cost
model WorkOrder {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  branchId          String?   @db.Uuid
  number            String    @db.VarChar(40)
  bomId             String    @db.Uuid
  productId         String    @db.Uuid
  qty               Decimal   @db.Decimal(18, 4)
  producedQty       Decimal   @default(0) @db.Decimal(18, 4)
  warehouseId       String    @db.Uuid
  outputWarehouseId String    @db.Uuid
  plannedDate       DateTime  @db.Date
  completedDate     DateTime? @db.Date
  /// DRAFT | RELEASED | DONE | CANCELLED
  status            String    @default("DRAFT") @db.VarChar(20)
  labourCost        Decimal   @default(0) @db.Decimal(18, 2)
  overheadCost      Decimal   @default(0) @db.Decimal(18, 2)
  materialCost      Decimal   @default(0) @db.Decimal(18, 2)
  totalCost         Decimal   @default(0) @db.Decimal(18, 2)
  unitCost          Decimal   @default(0) @db.Decimal(18, 4)
  /// finished goods lot (lot-tracked products)
  lotNo             String?   @db.VarChar(60)
  expiryDate        DateTime? @db.Date
  /// sub-assembly order made for a parent work order
  parentId          String?   @db.Uuid
  startedAt         DateTime?
  /// running cost in work in process: materials issued + conversion applied
  wipMaterial       Decimal   @default(0) @db.Decimal(18, 2)
  wipConversion     Decimal   @default(0) @db.Decimal(18, 2)
  scrapQty          Decimal   @default(0) @db.Decimal(18, 4)
  /// abnormal loss expensed at completion and value of by-products received
  abnormalLoss      Decimal   @default(0) @db.Decimal(18, 2)
  byProductValue    Decimal   @default(0) @db.Decimal(18, 2)
  /// standard cost of what was produced (for the variance)
  standardCost      Decimal   @default(0) @db.Decimal(18, 2)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime?

  lines      WorkOrderLine[]
  operations WorkOrderOperation[]
  outputs    WorkOrderOutput[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("work_orders")
}

model WorkOrderLine {
  id           String  @id @default(uuid()) @db.Uuid
  workOrderId  String  @db.Uuid
  lineNo       Int
  productId    String  @db.Uuid
  plannedQty   Decimal @db.Decimal(18, 4)
  /// actual quantity used (defaults to the planned quantity)
  consumedQty  Decimal @default(0) @db.Decimal(18, 4)
  /// already issued to work in process
  issuedQty    Decimal @default(0) @db.Decimal(18, 4)
  operationSeq Int?
  unitCost     Decimal @default(0) @db.Decimal(18, 4)
  lotId        String? @db.Uuid

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_lines")
}

/// Cashier shift: opening float, sales, counted cash at closing (difference posted as cash over / short)
model PosSession {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  branchId      String?   @db.Uuid
  number        String    @db.VarChar(40)
  outletId      String?   @db.Uuid
  warehouseId   String    @db.Uuid
  /// cash drawer (cash account)
  cashAccountId String    @db.Uuid
  openedAt      DateTime  @default(now())
  openedById    String?   @db.Uuid
  openingCash   Decimal   @default(0) @db.Decimal(18, 2)
  closedAt      DateTime?
  closedById    String?   @db.Uuid
  expectedCash  Decimal   @default(0) @db.Decimal(18, 2)
  countedCash   Decimal?  @db.Decimal(18, 2)
  /// OPEN | CLOSED
  status        String    @default("OPEN") @db.VarChar(10)
  notes         String?

  sales PosSale[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("pos_sessions")
}

/// A point-of-sale receipt (struk) or an open bill. For a PKP retailer the paid receipt is the simplified tax invoice (faktur pajak digunggung)
model PosSale {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  branchId       String?   @db.Uuid
  outletId       String?   @db.Uuid
  /// shift that took the payment (an open bill keeps the shift it was opened in until it is paid)
  sessionId      String    @db.Uuid
  /// receipt number, given when the bill is paid (gap-free numbering of the faktur pajak digunggung)
  number         String?   @db.VarChar(40)
  date           DateTime  @db.Date
  soldAt         DateTime  @default(now())
  customerId     String?   @db.Uuid
  /// RETAIL | DINE_IN | TAKEAWAY | DELIVERY
  orderType      String    @default("RETAIL") @db.VarChar(10)
  tableId        String?   @db.Uuid
  covers         Int       @default(0)
  /// bill name / customer name of a tab
  label          String?   @db.VarChar(60)
  /// daily queue number (counter service), e.g. A012
  queueNo        String?   @db.VarChar(12)
  /// net of VAT and regional tax, after discounts and including the service charge
  subtotal       Decimal   @default(0) @db.Decimal(18, 2)
  /// promotions and voucher discounts (already deducted)
  discount       Decimal   @default(0) @db.Decimal(18, 2)
  serviceCharge  Decimal   @default(0) @db.Decimal(18, 2)
  /// PPN (VAT) included in / added to the prices
  taxTotal       Decimal   @default(0) @db.Decimal(18, 2)
  /// PBJT (regional tax, UU 1/2022) on the amount after discount incl. service charge
  localTax       Decimal   @default(0) @db.Decimal(18, 2)
  total          Decimal   @default(0) @db.Decimal(18, 2)
  paid           Decimal   @default(0) @db.Decimal(18, 2)
  change         Decimal   @default(0) @db.Decimal(18, 2)
  /// [{ method: CASH | QRIS | CARD | TRANSFER | POINTS, amount, reference }]
  payments       Json      @default("[]")
  voucherCode    String?   @db.VarChar(40)
  /// [{ promotionId, code, name, amount }]
  promotions     Json      @default("[]")
  pointsEarned   Int       @default(0)
  pointsRedeemed Int       @default(0)
  /// OPEN (bill / tab not paid yet) | PAID | VOID | CANCELLED
  status         String    @default("PAID") @db.VarChar(10)
  /// NONE | PREPARING | READY | COLLECTED (queue board)
  kitchenStatus  String    @default("NONE") @db.VarChar(10)
  billPrintedAt  DateTime?
  readyAt        DateTime?
  collectedAt    DateTime?
  voidReason     String?   @db.VarChar(200)
  createdAt      DateTime  @default(now())
  createdById    String?   @db.Uuid
  updatedAt      DateTime  @default(now()) @updatedAt

  session PosSession         @relation(fields: [sessionId], references: [id])
  lines   PosSaleLine[]
  tickets PosKitchenTicket[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([sessionId])
  @@index([outletId, status])
  @@map("pos_sales")
}

model PosSaleLine {
  id            String    @id @default(uuid()) @db.Uuid
  saleId        String    @db.Uuid
  lineNo        Int
  productId     String    @db.Uuid
  name          String    @db.VarChar(200)
  qty           Decimal   @db.Decimal(18, 4)
  /// price shown to the customer incl. modifiers (incl. VAT when prices include tax)
  unitPrice     Decimal   @db.Decimal(18, 2)
  discountPct   Decimal   @default(0) @db.Decimal(9, 4)
  /// promotion / voucher discount allocated to this line (amount at shelf price)
  promoDiscount Decimal   @default(0) @db.Decimal(18, 2)
  /// [{ groupId, optionId, name, price, productId, qty }]
  modifiers     Json      @default("[]")
  note          String?   @db.VarChar(200)
  course        Int       @default(1)
  station       String?   @db.VarChar(30)
  ticketId      String?   @db.Uuid
  sentAt        DateTime?
  /// POS (staff) | QR (ordered by the guest from the table QR code)
  source        String    @default("POS") @db.VarChar(10)
  /// ACTIVE | VOID (removed after it was sent to the kitchen)
  status        String    @default("ACTIVE") @db.VarChar(10)
  voidReason    String?   @db.VarChar(200)
  taxId         String?   @db.Uuid
  /// net (DPP), VAT and total of the line
  lineNet       Decimal   @default(0) @db.Decimal(18, 2)
  lineTax       Decimal   @default(0) @db.Decimal(18, 2)
  lineTotal     Decimal   @default(0) @db.Decimal(18, 2)
  unitCost      Decimal   @default(0) @db.Decimal(18, 4)

  sale   PosSale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  ticket PosKitchenTicket? @relation(fields: [ticketId], references: [id])

  @@index([saleId])
  @@map("pos_sale_lines")
}

/// A selling point (shop, restaurant, cafe, food-court stall) with its own tax mode, service style and devices
model PosOutlet {
  id                   String    @id @default(uuid()) @db.Uuid
  companyId            String    @db.Uuid
  branchId             String?   @db.Uuid
  code                 String    @db.VarChar(20)
  name                 String    @db.VarChar(100)
  warehouseId          String    @db.Uuid
  /// RETAIL (PPN; receipt = faktur pajak digunggung) | FNB (restaurant / cafe: PBJT instead of PPN)
  mode                 String    @default("RETAIL") @db.VarChar(10)
  /// COUNTER (pay first, queue number) | TABLE (table service, pay at the end)
  serviceStyle         String    @default("COUNTER") @db.VarChar(10)
  pricesIncludeTax     Boolean   @default(true)
  /// PBJT rate of the regional regulation (Perda), at most 10% for food and beverage (UU 1/2022 Art. 58)
  pbjtRate             Decimal   @default(0) @db.Decimal(9, 4)
  serviceChargePct     Decimal   @default(0) @db.Decimal(9, 4)
  /// service charge collected for the staff (Permenaker 7/2016): a liability, not revenue
  serviceChargeToStaff Boolean   @default(false)
  priceListId          String?   @db.Uuid
  /// the menu of the outlet is only what its price list contains (a restaurant inside a company that also sells other things)
  menuFromPriceList    Boolean   @default(false)
  qrisAccountId        String?   @db.Uuid
  cardAccountId        String?   @db.Uuid
  transferAccountId    String?   @db.Uuid
  queuePrefix          String    @default("A") @db.VarChar(5)
  queueDate            DateTime? @db.Date
  queueNext            Int       @default(1)
  receiptFooter        String?   @db.VarChar(300)
  /// customer display idle message
  displayMessage       String?   @db.VarChar(300)
  /// queue board announcement, {number} is replaced by the queue number
  readyAnnouncement    String    @default("Order {number} is ready") @db.VarChar(200)
  /// ordering from the table QR code: OFF | CONFIRM (a waiter confirms before the kitchen gets it) | AUTO
  selfOrder            String    @default("OFF") @db.VarChar(10)
  kdsWarnMinutes       Int       @default(10)
  kdsLateMinutes       Int       @default(20)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdById          String?   @db.Uuid
  updatedById          String?   @db.Uuid
  deletedAt            DateTime?

  @@unique([companyId, code])
  @@map("pos_outlets")
}

model PosTable {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  outletId    String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  area        String?   @db.VarChar(60)
  seats       Int       @default(4)
  sortOrder   Int       @default(0)
  /// secret of the table QR code (customers order from their phone); a new one invalidates printed codes
  qrToken     String?   @unique @db.VarChar(64)
  /// WAITER | BILL: the guests called from the QR page
  callType    String?   @db.VarChar(10)
  calledAt    DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@index([outletId])
  @@map("pos_tables")
}

/// A kitchen / bar ticket: the items of one order sent to one station in one round (KDS)
model PosKitchenTicket {
  id        String    @id @default(uuid()) @db.Uuid
  companyId String    @db.Uuid
  outletId  String    @db.Uuid
  saleId    String    @db.Uuid
  round     Int       @default(1)
  station   String    @db.VarChar(30)
  course    Int       @default(1)
  /// table / queue number / bill name shown on the ticket
  label     String    @db.VarChar(60)
  /// HELD (course not fired yet) | NEW | PREPARING | READY | SERVED | VOID
  status    String    @default("NEW") @db.VarChar(10)
  createdAt DateTime  @default(now())
  firedAt   DateTime?
  startedAt DateTime?
  readyAt   DateTime?
  servedAt  DateTime?

  sale  PosSale       @relation(fields: [saleId], references: [id], onDelete: Cascade)
  lines PosSaleLine[]

  @@index([outletId, status])
  @@map("pos_kitchen_tickets")
}

/// Add-ons / choices for menu items (size, sugar level, extra cheese...)
model PosModifierGroup {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String   @db.VarChar(80)
  minSelect Int      @default(0)
  maxSelect Int      @default(1)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options  PosModifierOption[]
  products PosProductModifier[]

  @@index([companyId])
  @@map("pos_modifier_groups")
}

model PosModifierOption {
  id        String  @id @default(uuid()) @db.Uuid
  groupId   String  @db.Uuid
  name      String  @db.VarChar(80)
  price     Decimal @default(0) @db.Decimal(18, 2)
  /// ingredient issued from stock when chosen (optional)
  productId String? @db.Uuid
  qty       Decimal @default(1) @db.Decimal(18, 4)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  group PosModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("pos_modifier_options")
}

model PosProductModifier {
  productId String @db.Uuid
  groupId   String @db.Uuid
  sortOrder Int    @default(0)

  group PosModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@map("pos_product_modifiers")
}

/// Selling prices per outlet / channel (falls back to the product sale price)
model PriceList {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  items PriceListItem[]

  @@unique([companyId, code])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid()) @db.Uuid
  priceListId String  @db.Uuid
  productId   String  @db.Uuid
  price       Decimal @db.Decimal(18, 2)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

/// POS promotions: item discounts, buy X get Y, bill discounts, happy hours, vouchers, member-only offers
model PosPromotion {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(120)
  /// ITEM_PERCENT | ITEM_AMOUNT | BUY_X_GET_Y | BILL_PERCENT | BILL_AMOUNT
  type        String    @db.VarChar(15)
  value       Decimal   @default(0) @db.Decimal(18, 4)
  buyQty      Int       @default(0)
  getQty      Int       @default(0)
  minSpend    Decimal   @default(0) @db.Decimal(18, 2)
  /// cap of a percentage bill discount (0 = no cap)
  maxDiscount Decimal   @default(0) @db.Decimal(18, 2)
  productIds  String[]  @db.Uuid
  categoryIds String[]  @db.Uuid
  /// empty = every outlet
  outletIds   String[]  @db.Uuid
  membersOnly Boolean   @default(false)
  /// when set, only applies after the cashier enters this voucher code
  voucherCode String?   @db.VarChar(40)
  startDate   DateTime? @db.Date
  endDate     DateTime? @db.Date
  /// 0 = Sunday ... 6 = Saturday; empty = every day
  days        Int[]
  /// happy hour window HH:MM (company time zone)
  timeFrom    String?   @db.VarChar(5)
  timeTo      String?   @db.VarChar(5)
  maxUses     Int       @default(0)
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("pos_promotions")
}

/// Loyalty points ledger of a member
model PosPointEntry {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  customerId  String   @db.Uuid
  saleId      String?  @db.Uuid
  points      Int
  reason      String   @db.VarChar(120)
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@index([companyId, customerId])
  @@map("pos_point_entries")
}

/// A machine, line or team where production steps run, with its cost rates and normal capacity
model WorkCenter {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  code          String    @db.VarChar(20)
  name          String    @db.VarChar(100)
  /// direct labour per hour (operators of the step)
  labourRate    Decimal   @default(0) @db.Decimal(18, 2)
  /// machine cost per hour (depreciation, power, maintenance)
  machineRate   Decimal   @default(0) @db.Decimal(18, 2)
  /// other production overhead per hour
  overheadRate  Decimal   @default(0) @db.Decimal(18, 2)
  /// normal capacity in hours per month: fixed overhead is absorbed on it, the unabsorbed part is a period expense
  capacityHours Decimal   @default(0) @db.Decimal(18, 2)
  /// number of machines / stations working in parallel
  stations      Int       @default(1)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  @@unique([companyId, code])
  @@map("work_centers")
}

/// Routing step of a bill of materials
model BomOperation {
  id           String  @id @default(uuid()) @db.Uuid
  bomId        String  @db.Uuid
  seq          Int
  name         String  @db.VarChar(120)
  workCenterId String? @db.Uuid
  /// minutes per batch to set up, and per finished unit to run
  setupMinutes Decimal @default(0) @db.Decimal(18, 2)
  runMinutes   Decimal @default(0) @db.Decimal(18, 4)
  instructions String? @db.VarChar(1000)
  /// INTERNAL (own work centre) | SUBCONTRACT (maklon: done by a supplier, paid per unit)
  kind         String  @default("INTERNAL") @db.VarChar(12)
  supplierId   String? @db.Uuid
  /// service fee per finished unit (excl. PPN)
  servicePrice Decimal @default(0) @db.Decimal(18, 2)

  bom Bom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@map("bom_operations")
}

/// Other products a BOM yields: co-products (share of the joint cost) and by-products (valued at net realisable value)
model BomOutput {
  id           String  @id @default(uuid()) @db.Uuid
  bomId        String  @db.Uuid
  productId    String  @db.Uuid
  /// CO | BY
  kind         String  @db.VarChar(5)
  /// per batch
  qty          Decimal @db.Decimal(18, 4)
  /// co-product share of the joint cost in percent (the main product takes the rest)
  costSharePct Decimal @default(0) @db.Decimal(9, 4)
  /// by-product: net realisable value per unit (selling price less costs to sell), deducted from the main cost
  nrvPerUnit   Decimal @default(0) @db.Decimal(18, 4)

  bom Bom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@map("bom_outputs")
}

/// A routing step of a work order: planned vs actual time, good and scrap quantity, cost applied
model WorkOrderOperation {
  id             String    @id @default(uuid()) @db.Uuid
  workOrderId    String    @db.Uuid
  seq            Int
  name           String    @db.VarChar(120)
  workCenterId   String?   @db.Uuid
  plannedMinutes Decimal   @default(0) @db.Decimal(18, 2)
  actualMinutes  Decimal   @default(0) @db.Decimal(18, 2)
  goodQty        Decimal   @default(0) @db.Decimal(18, 4)
  scrapQty       Decimal   @default(0) @db.Decimal(18, 4)
  /// PENDING | RUNNING | PAUSED | DONE
  status         String    @default("PENDING") @db.VarChar(10)
  /// running since (cleared when paused)
  runningSince   DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  operatorId     String?   @db.Uuid
  /// rates at the time of the order
  labourRate     Decimal   @default(0) @db.Decimal(18, 2)
  machineRate    Decimal   @default(0) @db.Decimal(18, 2)
  overheadRate   Decimal   @default(0) @db.Decimal(18, 2)
  /// conversion cost already applied to work in process
  appliedCost    Decimal   @default(0) @db.Decimal(18, 2)
  notes          String?   @db.VarChar(500)
  /// maklon: subcontractor, fee per unit, materials sent / goods back, the supplier invoice drafted for the fee
  kind           String    @default("INTERNAL") @db.VarChar(12)
  supplierId     String?   @db.Uuid
  servicePrice   Decimal   @default(0) @db.Decimal(18, 2)
  sentAt         DateTime?
  receivedAt     DateTime?
  invoiceId      String?   @db.Uuid

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([workCenterId, status])
  @@map("work_order_operations")
}

/// Co- and by-products of a work order
model WorkOrderOutput {
  id           String  @id @default(uuid()) @db.Uuid
  workOrderId  String  @db.Uuid
  productId    String  @db.Uuid
  kind         String  @db.VarChar(5)
  plannedQty   Decimal @db.Decimal(18, 4)
  producedQty  Decimal @default(0) @db.Decimal(18, 4)
  costSharePct Decimal @default(0) @db.Decimal(9, 4)
  nrvPerUnit   Decimal @default(0) @db.Decimal(18, 4)
  unitCost     Decimal @default(0) @db.Decimal(18, 4)

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@map("work_order_outputs")
}

/// Inspection plan: what to check, when (goods receipt, production) and the specification of each parameter
model QcPlan {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(150)
  /// RECEIPT (incoming materials) | PRODUCTION (finished goods of a work order)
  stage       String    @db.VarChar(12)
  /// one product, or every product of a category (empty both = all products at that stage)
  productId   String?   @db.Uuid
  categoryId  String?   @db.Uuid
  /// sampling rule shown to the inspector, e.g. "AQL 2.5, general level II" or "3 cans per batch"
  sampling    String?   @db.VarChar(200)
  /// lots stay on hold (cannot be issued or sold) until the inspection passes
  holdLots    Boolean   @default(true)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  params QcPlanParam[]

  @@unique([companyId, code])
  @@map("qc_plans")
}

model QcPlanParam {
  id      String   @id @default(uuid()) @db.Uuid
  planId  String   @db.Uuid
  seq     Int
  name    String   @db.VarChar(120)
  /// NUMBER (measured, within min / max) | CHECK (pass / fail) | TEXT (observation)
  kind    String   @db.VarChar(10)
  unit    String?  @db.VarChar(20)
  min     Decimal? @db.Decimal(18, 6)
  max     Decimal? @db.Decimal(18, 6)
  target  Decimal? @db.Decimal(18, 6)
  method  String?  @db.VarChar(200)
  /// a failed critical parameter fails the inspection; others only warn
  critical Boolean @default(true)

  plan QcPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("qc_plan_params")
}

/// One inspection of a received or produced lot
model QcInspection {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  number       String    @db.VarChar(40)
  planId       String    @db.Uuid
  stage        String    @db.VarChar(12)
  productId    String    @db.Uuid
  /// GR (goods receipt) | WO (work order)
  sourceType   String    @db.VarChar(10)
  sourceId     String    @db.Uuid
  sourceNumber String    @db.VarChar(40)
  lotId        String?   @db.Uuid
  lotNo        String?   @db.VarChar(60)
  qty          Decimal   @db.Decimal(18, 4)
  sampleQty    Decimal   @default(0) @db.Decimal(18, 4)
  /// PENDING | PASSED | FAILED | CONDITIONAL (accepted with deviation)
  status       String    @default("PENDING") @db.VarChar(12)
  inspectedAt  DateTime?
  inspectorId  String?   @db.Uuid
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  results QcResult[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([sourceType, sourceId])
  @@map("qc_inspections")
}

model QcResult {
  id           String   @id @default(uuid()) @db.Uuid
  inspectionId String   @db.Uuid
  seq          Int
  name         String   @db.VarChar(120)
  kind         String   @db.VarChar(10)
  unit         String?  @db.VarChar(20)
  min          Decimal? @db.Decimal(18, 6)
  max          Decimal? @db.Decimal(18, 6)
  method       String?  @db.VarChar(200)
  critical     Boolean  @default(true)
  valueNumber  Decimal? @db.Decimal(18, 6)
  valueText    String?  @db.VarChar(500)
  pass         Boolean?

  inspection QcInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  @@map("qc_results")
}

/// Non-conformance report with disposition and corrective / preventive action (CAPA)
model QcNcr {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  number          String    @db.VarChar(40)
  inspectionId    String?   @db.Uuid
  productId       String    @db.Uuid
  lotId           String?   @db.Uuid
  lotNo           String?   @db.VarChar(60)
  supplierId      String?   @db.Uuid
  qty             Decimal   @default(0) @db.Decimal(18, 4)
  description     String
  /// REWORK | SCRAP | USE_AS_IS | RETURN (to the supplier) | SORT
  disposition     String?   @db.VarChar(12)
  rootCause       String?
  correctiveAction String?
  dueDate         DateTime? @db.Date
  /// OPEN | CLOSED
  status          String    @default("OPEN") @db.VarChar(10)
  closedAt        DateTime?
  closedById      String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   @db.Uuid

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("qc_ncrs")
}

/// Machine, mould, tool, vehicle or other equipment that is maintained (and may be inspected under K3 rules)
model Equipment {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(150)
  /// MACHINE | MOULD | TOOL | VEHICLE | PRESSURE (boiler / pressure vessel) | LIFTING | ELECTRICAL | OTHER
  kind             String    @default("MACHINE") @db.VarChar(12)
  workCenterId     String?   @db.Uuid
  fixedAssetId     String?   @db.Uuid
  manufacturer     String?   @db.VarChar(100)
  model            String?   @db.VarChar(100)
  serialNo         String?   @db.VarChar(100)
  location         String?   @db.VarChar(150)
  /// RUNNING | DOWN | RETIRED
  status           String    @default("RUNNING") @db.VarChar(10)
  /// usage counter for counter-based maintenance: HOURS | SHOTS | KM | CYCLES
  counterUnit      String    @default("HOURS") @db.VarChar(10)
  counter          Decimal   @default(0) @db.Decimal(18, 2)
  /// K3 periodic inspection (riksa uji, Permenaker 38/2016 / 37/2016): certificate and its expiry
  inspectionCertNo String?   @db.VarChar(100)
  inspectionExpiry DateTime? @db.Date
  notes            String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  @@unique([companyId, code])
  @@map("equipment")
}

/// Preventive maintenance plan of an equipment: every N days and / or every N counter units
model MaintenancePlan {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  equipmentId     String    @db.Uuid
  name            String    @db.VarChar(150)
  intervalDays    Int       @default(0)
  intervalCounter Decimal   @default(0) @db.Decimal(18, 2)
  /// order created this many days before it is due
  leadDays        Int       @default(3)
  checklist       String?
  estimatedMinutes Int      @default(0)
  lastDoneAt      DateTime? @db.Date
  lastCounter     Decimal   @default(0) @db.Decimal(18, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, equipmentId])
  @@map("maintenance_plans")
}

/// Maintenance work: preventive, breakdown repair or inspection; parts used leave stock to the maintenance expense
model MaintenanceOrder {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  number          String    @db.VarChar(40)
  equipmentId     String    @db.Uuid
  planId          String?   @db.Uuid
  /// PREVENTIVE | BREAKDOWN | INSPECTION
  type            String    @db.VarChar(12)
  /// OPEN | IN_PROGRESS | DONE | CANCELLED
  status          String    @default("OPEN") @db.VarChar(12)
  priority        String    @default("NORMAL") @db.VarChar(8)
  description     String
  dueDate         DateTime? @db.Date
  reportedAt      DateTime  @default(now())
  startedAt       DateTime?
  doneAt          DateTime?
  /// equipment stopped (breakdown) from reportedAt until done
  stopsEquipment  Boolean   @default(false)
  downtimeMinutes Decimal   @default(0) @db.Decimal(18, 2)
  workDone        String?
  technician      String?   @db.VarChar(120)
  labourHours     Decimal   @default(0) @db.Decimal(18, 2)
  labourCost      Decimal   @default(0) @db.Decimal(18, 2)
  partsCost       Decimal   @default(0) @db.Decimal(18, 2)
  counterAtDone   Decimal?  @db.Decimal(18, 2)
  warehouseId     String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   @db.Uuid

  parts MaintenancePart[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([equipmentId])
  @@map("maintenance_orders")
}

model MaintenancePart {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @db.Uuid
  productId String  @db.Uuid
  qty       Decimal @db.Decimal(18, 4)
  unitCost  Decimal @default(0) @db.Decimal(18, 4)

  order MaintenanceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("maintenance_parts")
}

/// Stop of a work centre / equipment, for availability and OEE
model DowntimeEvent {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  workCenterId String?   @db.Uuid
  equipmentId  String?   @db.Uuid
  startAt      DateTime
  endAt        DateTime?
  minutes      Decimal   @default(0) @db.Decimal(18, 2)
  /// BREAKDOWN | SETUP | NO_MATERIAL | NO_OPERATOR | QUALITY | POWER | PLANNED (planned stops do not lower availability)
  reason       String    @db.VarChar(15)
  planned      Boolean   @default(false)
  maintenanceOrderId String? @db.Uuid
  notes        String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  createdById  String?   @db.Uuid

  @@index([companyId, startAt])
  @@map("downtime_events")
}

// ----------------------------------------------------------------------------
// Compliance: certificates, TKDN, B3 waste, SIINas
// ----------------------------------------------------------------------------

/// Licence / certificate held by the company or by a supplier: halal (UU 33/2014 jo UU 6/2023, PP 42/2024),
/// BPOM MD / ML, PIRT, SPPT-SNI, TKDN (Permenperin 35/2025, 5 years), ISO, HACCP, NKV...
model ComplianceCertificate {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  /// HALAL | BPOM_MD | BPOM_ML | PIRT | SNI | TKDN | ISO | HACCP | NKV | ISPO | OTHER
  type         String    @db.VarChar(10)
  number       String    @db.VarChar(100)
  title        String    @db.VarChar(200)
  issuer       String?   @db.VarChar(150)
  /// OWN (ours) | SUPPLIER (a supplier's certificate for the materials it sells us)
  holder       String    @default("OWN") @db.VarChar(10)
  supplierId   String?   @db.Uuid
  issuedAt     DateTime? @db.Date
  /// empty = no fixed expiry (halal: valid while ingredients and process stay the same)
  expiresAt    DateTime? @db.Date
  /// TKDN certificates: the TKDN and BMP values (%)
  tkdnValue    Decimal?  @db.Decimal(6, 2)
  bmpValue     Decimal?  @db.Decimal(6, 2)
  scope        String?
  /// set when something covered by the certificate changed (e.g. the recipe of a halal product)
  reviewNeeded Boolean   @default(false)
  reviewReason String?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  products ComplianceCertificateProduct[]

  @@index([companyId, type])
  @@map("compliance_certificates")
}

model ComplianceCertificateProduct {
  certificateId String @db.Uuid
  productId     String @db.Uuid

  certificate ComplianceCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([certificateId, productId])
  @@index([productId])
  @@map("compliance_certificate_products")
}

/// TKDN self-assessment of a product (Permenperin 35/2025 Art. 4-12, Annex I forms 1.1-1.4 and Annex II brainware)
model TkdnAssessment {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  number              String    @db.VarChar(40)
  productId           String    @db.Uuid
  bomId               String?   @db.Uuid
  date                DateTime  @db.Date
  productType         String?   @db.VarChar(150)
  specification       String?   @db.VarChar(300)
  standard            String?   @db.VarChar(100)
  /// OWN (own / rented factory) | OTHER_FACTORY (own staff in another firm's factory) | OUTSOURCED (made by another firm)
  productionMode      String    @default("OWN") @db.VarChar(15)
  investedInIndonesia Boolean   @default(true)
  directLabourTotal   Int       @default(0)
  directLabourWni     Int       @default(0)
  /// brainware criteria scores 0-100 (Annex II): R&D investment 30%, R&D unit 20%, R&D programme 20%, implementation 30%
  bwInvestment        Decimal   @default(0) @db.Decimal(6, 2)
  bwUnit              Decimal   @default(0) @db.Decimal(6, 2)
  bwProgram           Decimal   @default(0) @db.Decimal(6, 2)
  bwImplementation    Decimal   @default(0) @db.Decimal(6, 2)
  materialFactor      Decimal   @default(0) @db.Decimal(9, 4)
  labourFactor        Decimal   @default(0) @db.Decimal(9, 4)
  overheadFactor      Decimal   @default(0) @db.Decimal(9, 4)
  brainware           Decimal   @default(0) @db.Decimal(9, 4)
  tkdn                Decimal   @default(0) @db.Decimal(9, 4)
  /// DRAFT | FINAL
  status              String    @default("DRAFT") @db.VarChar(8)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?   @db.Uuid
  updatedById         String?   @db.Uuid
  deletedAt           DateTime?

  lines TkdnAssessmentLine[]

  @@unique([companyId, number])
  @@index([companyId, productId])
  @@map("tkdn_assessments")
}

model TkdnAssessmentLine {
  id                   String   @id @default(uuid()) @db.Uuid
  assessmentId         String   @db.Uuid
  seq                  Int
  productId            String?  @db.Uuid
  description          String   @db.VarChar(200)
  specification        String?  @db.VarChar(200)
  uom                  String?  @db.VarChar(20)
  originCountry        String   @default("ID") @db.VarChar(3)
  qty                  Decimal  @db.Decimal(18, 4)
  unitPrice            Decimal  @db.Decimal(18, 2)
  /// component has a TKDN certificate and its value (%)
  hasCertificate       Boolean  @default(false)
  certTkdn             Decimal? @db.Decimal(6, 2)
  /// no certificate: made in Indonesia by an industrial company; and all of its own materials domestic / natural resource
  domesticProducer     Boolean  @default(false)
  allDomesticMaterials Boolean  @default(false)
  /// credited domestic share (Art. 5 (2)) and its contribution to the material factor
  creditPct            Decimal  @default(0) @db.Decimal(6, 2)
  share                Decimal  @default(0) @db.Decimal(9, 4)

  assessment TkdnAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("tkdn_assessment_lines")
}

/// B3 (hazardous) waste type per PP 22/2021 Annex IX (e.g. B105d used lubricating oil, category 2)
model WasteType {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  code              String    @db.VarChar(20)
  name              String    @db.VarChar(200)
  /// hazard category 1 | 2
  category          Int       @default(2)
  /// NON_SPECIFIC | EXPIRED | SPECIFIC_GENERAL | SPECIFIC_SPECIAL
  sourceType        String    @default("NON_SPECIFIC") @db.VarChar(20)
  /// explosive, flammable, reactive, infectious, corrosive, toxic
  characteristics   String?   @db.VarChar(200)
  /// generated at 50 kg a day or more: storage at most 90 days (Permen LHK 6/2021 Art. 79)
  atLeast50KgPerDay Boolean   @default(false)
  storageLocation   String?   @db.VarChar(150)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime?

  @@unique([companyId, code])
  @@map("waste_types")
}

/// B3 waste put into the temporary store (logbook "in", Permen LHK 6/2021 Annex IX form A)
model WasteEntry {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  wasteTypeId    String   @db.Uuid
  date           DateTime @db.Date
  source         String?  @db.VarChar(200)
  /// kilograms
  qty            Decimal  @db.Decimal(18, 3)
  remainingQty   Decimal  @db.Decimal(18, 3)
  storageDays    Int
  maxStorageDate DateTime @db.Date
  notes          String?  @db.VarChar(500)
  /// POSTED | CANCELLED
  status         String   @default("POSTED") @db.VarChar(10)
  createdAt      DateTime @default(now())
  createdById    String?  @db.Uuid

  @@index([companyId, wasteTypeId, date])
  @@map("waste_entries")
}

/// B3 waste leaving the store: handed to a licensed transporter / receiver with the Festronik manifest, or
/// utilised / treated / landfilled by the company itself
model WasteHandover {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  number        String   @db.VarChar(40)
  date          DateTime @db.Date
  /// HANDED_OVER | UTILISED | TREATED | LANDFILLED | EXPORTED | OTHER
  treatment     String   @db.VarChar(12)
  transporterId String?  @db.Uuid
  receiverId    String?  @db.Uuid
  manifestNo    String?  @db.VarChar(60)
  vehicleNo     String?  @db.VarChar(30)
  licenceNo     String?  @db.VarChar(100)
  notes         String?  @db.VarChar(500)
  /// POSTED | CANCELLED
  status        String   @default("POSTED") @db.VarChar(10)
  createdAt     DateTime @default(now())
  createdById   String?  @db.Uuid

  lines WasteHandoverLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("waste_handovers")
}

model WasteHandoverLine {
  id          String  @id @default(uuid()) @db.Uuid
  handoverId  String  @db.Uuid
  wasteTypeId String  @db.Uuid
  qty         Decimal @db.Decimal(18, 3)
  /// entries taken (first in, first out): [{ entryId, qty }]
  allocations Json    @default("[]")

  handover WasteHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@map("waste_handover_lines")
}

/// Quarterly SIINas report (Permenperin 13/2025): figures the ERP derives plus what is entered by hand
model SiinasReport {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  year        Int
  quarter     Int
  /// figures entered by hand (capacity, energy, water, investment...)
  inputs      Json      @default("{}")
  /// DRAFT | SUBMITTED
  status      String    @default("DRAFT") @db.VarChar(10)
  submittedAt DateTime?
  receiptNo   String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String?   @db.Uuid

  @@unique([companyId, year, quarter])
  @@map("siinas_reports")
}
