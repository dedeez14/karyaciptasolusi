  latitude      Decimal?  @db.Decimal(10, 7)
  longitude     Decimal?  @db.Decimal(10, 7)
  radiusKm      Decimal?  @db.Decimal(8, 2)
  zoom          Int?
  depth         Int       @default(3)
  languageCode  String    @default("id") @db.VarChar(10)
  extractEmails Boolean   @default(true)
  fastMode      Boolean   @default(false)
  statusCode    String    @default("QUEUED") @db.VarChar(20) // lookup SCRAPE_STATUS
  startedAt     DateTime?
  finishedAt    DateTime?
  resultCount   Int       @default(0)
  newCount      Int       @default(0)
  error         String?
  logTail       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
