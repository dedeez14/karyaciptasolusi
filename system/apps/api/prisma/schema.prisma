// ----------------------------------------------------------------------------
// Trade documents: sales, purchase, inventory (one generic engine)
//   SQ quotation, SO sales order, DO delivery, SI sales invoice,
//   PR purchase request, PO purchase order, GR goods receipt, PI purchase invoice,
//   ADJ stock adjustment, TRF stock transfer
// ----------------------------------------------------------------------------

model TradeDocument {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  branchId         String?   @db.Uuid
  docType          String    @db.VarChar(10)
  number           String    @db.VarChar(40)
  date             DateTime  @db.Date
  dueDate          DateTime? @db.Date
  status           DocStatus @default(DRAFT)
  customerId       String?   @db.Uuid
  supplierId       String?   @db.Uuid
  warehouseId      String?   @db.Uuid
  toWarehouseId    String?   @db.Uuid
  /// recurring billing subscription that generated this invoice
  subscriptionId   String?   @db.Uuid
  /// opening balance document (go-live): posts against Opening Balance Equity, no revenue / stock movement
  isOpening        Boolean   @default(false)
  /// Indonesian tax invoice number (Nomor Faktur Pajak)
  taxInvoiceNumber String?   @db.VarChar(40)
  paymentTermId    String?   @db.Uuid
  projectId        String?   @db.Uuid
  opportunityId    String?   @db.Uuid
  sourceId         String?   @db.Uuid
  currencyCode     String    @default("IDR") @db.VarChar(3)
  exchangeRate     Decimal   @default(1) @db.Decimal(18, 6)
  reference        String?   @db.VarChar(100)
  notes            String?
  terms            String?
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  discountTotal    Decimal   @default(0) @db.Decimal(18, 2)
  taxTotal         Decimal   @default(0) @db.Decimal(18, 2)
  grandTotal       Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount       Decimal   @default(0) @db.Decimal(18, 2)
  /// invoices: part settled by credit / debit notes (included in paidAmount); credit notes: part applied to invoices
  creditedAmount   Decimal   @default(0) @db.Decimal(18, 2)
  ownerId          String?   @db.Uuid
  confirmedById    String?   @db.Uuid
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  lines       TradeDocumentLine[]
  source      TradeDocument?      @relation("DocSource", fields: [sourceId], references: [id])
  derived     TradeDocument[]     @relation("DocSource")
  allocations PaymentAllocation[]

  @@unique([companyId, docType, number])
  @@index([companyId, docType, date])
  @@index([customerId])
  @@index([supplierId])
  @@index([subscriptionId])
  @@map("trade_documents")
}

model TradeDocumentLine {
  id           String    @id @default(uuid()) @db.Uuid
  documentId   String    @db.Uuid
  lineNo       Int
  productId    String?   @db.Uuid
  description  String?
  qty          Decimal   @db.Decimal(18, 4)
  uomId        String?   @db.Uuid
  unitPrice    Decimal   @default(0) @db.Decimal(18, 2)
  discountPct  Decimal   @default(0) @db.Decimal(9, 4)
  taxId        String?   @db.Uuid
  taxRate      Decimal   @default(0) @db.Decimal(9, 4)
  lineSubtotal Decimal   @default(0) @db.Decimal(18, 2)
  lineDiscount Decimal   @default(0) @db.Decimal(18, 2)
  lineTax      Decimal   @default(0) @db.Decimal(18, 2)
  lineTotal    Decimal   @default(0) @db.Decimal(18, 2)
  unitCost     Decimal   @default(0) @db.Decimal(18, 4)
  processedQty Decimal   @default(0) @db.Decimal(18, 4) // qty already converted downstream
  /// lot-tracked products: lot received (number + expiry) or the lot chosen to issue from (empty = FEFO)
  lotNo        String?   @db.VarChar(60)
  expiryDate   DateTime? @db.Date
  lotId        String?   @db.Uuid
  sourceLineId String?   @db.Uuid

  document TradeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([productId])
  @@map("trade_document_lines")
}

model Payment {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @db.Uuid
  branchId        String?          @db.Uuid
  number          String           @db.VarChar(40)
  date            DateTime         @db.Date
  direction       PaymentDirection
  customerId      String?          @db.Uuid
  supplierId      String?          @db.Uuid
  bankAccountId   String           @db.Uuid
  paymentMethodId String?          @db.Uuid
  amount          Decimal          @db.Decimal(18, 2)
  reference       String?          @db.VarChar(100)
  /// income tax withheld on this payment (PPh 23 / 4(2) / final): IN = withheld by the customer, OUT = withheld by us
  whtTaxId        String?          @db.Uuid
  whtBase         Decimal          @default(0) @db.Decimal(18, 2)
  whtRate         Decimal          @default(0) @db.Decimal(9, 4)
  whtAmount       Decimal          @default(0) @db.Decimal(18, 2)
  /// number and date of the withholding slip (bukti potong)
  whtSlipNo       String?          @db.VarChar(60)
  whtSlipDate     DateTime?        @db.Date
  notes           String?
  status          DocStatus        @default(CONFIRMED)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?          @db.Uuid
  updatedById     String?          @db.Uuid
  deletedAt       DateTime?

  allocations PaymentAllocation[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("payments")
}

