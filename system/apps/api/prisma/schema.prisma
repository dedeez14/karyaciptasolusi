/// SHA-256 fingerprint of every digitally signed PDF issued. Lets the public verify page tell an
/// untouched file from one that was edited after it was issued.
model SignedFile {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  /// sha256 of the signature token printed in the QR code
  tokenHash String   @db.VarChar(64)
  /// short code printed in the QR code (/verify?c=...) - keeps the QR small and easy to scan
  code      String?  @db.VarChar(24)
  /// full signature token (public: it is what the QR used to contain)
  token     String?
  sha256    String   @db.VarChar(64)
  size      Int
  docKind   String   @db.VarChar(20)
  docNumber String?  @db.VarChar(60)
  createdAt DateTime @default(now())

  @@index([sha256])
  @@index([tokenHash])
  @@index([code])
  @@map("signed_files")
}

