  @@index([companyId, startAt])
  @@map("downtime_events")
}

// ----------------------------------------------------------------------------
// Compliance: certificates, TKDN, B3 waste, SIINas
// ----------------------------------------------------------------------------

/// Licence / certificate held by the company or by a supplier: halal (UU 33/2014 jo UU 6/2023, PP 42/2024),
/// BPOM MD / ML, PIRT, SPPT-SNI, TKDN (Permenperin 35/2025, 5 years), ISO, HACCP, NKV...
model ComplianceCertificate {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  /// HALAL | BPOM_MD | BPOM_ML | PIRT | SNI | TKDN | ISO | HACCP | NKV | ISPO | OTHER
  type         String    @db.VarChar(10)
  number       String    @db.VarChar(100)
  title        String    @db.VarChar(200)
  issuer       String?   @db.VarChar(150)
  /// OWN (ours) | SUPPLIER (a supplier's certificate for the materials it sells us)
  holder       String    @default("OWN") @db.VarChar(10)
  supplierId   String?   @db.Uuid
  issuedAt     DateTime? @db.Date
  /// empty = no fixed expiry (halal: valid while ingredients and process stay the same)
  expiresAt    DateTime? @db.Date
  /// TKDN certificates: the TKDN and BMP values (%)
  tkdnValue    Decimal?  @db.Decimal(6, 2)
  bmpValue     Decimal?  @db.Decimal(6, 2)
  scope        String?
  /// set when something covered by the certificate changed (e.g. the recipe of a halal product)
  reviewNeeded Boolean   @default(false)
  reviewReason String?
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  products ComplianceCertificateProduct[]

  @@index([companyId, type])
  @@map("compliance_certificates")
}

model ComplianceCertificateProduct {
  certificateId String @db.Uuid
  productId     String @db.Uuid

  certificate ComplianceCertificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@id([certificateId, productId])
  @@index([productId])
  @@map("compliance_certificate_products")
}

/// TKDN self-assessment of a product (Permenperin 35/2025 Art. 4-12, Annex I forms 1.1-1.4 and Annex II brainware)
model TkdnAssessment {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  number              String    @db.VarChar(40)
  productId           String    @db.Uuid
  bomId               String?   @db.Uuid
  date                DateTime  @db.Date
  productType         String?   @db.VarChar(150)
  specification       String?   @db.VarChar(300)
  standard            String?   @db.VarChar(100)
  /// OWN (own / rented factory) | OTHER_FACTORY (own staff in another firm's factory) | OUTSOURCED (made by another firm)
  productionMode      String    @default("OWN") @db.VarChar(15)
  investedInIndonesia Boolean   @default(true)
  directLabourTotal   Int       @default(0)
  directLabourWni     Int       @default(0)
  /// brainware criteria scores 0-100 (Annex II): R&D investment 30%, R&D unit 20%, R&D programme 20%, implementation 30%
  bwInvestment        Decimal   @default(0) @db.Decimal(6, 2)
  bwUnit              Decimal   @default(0) @db.Decimal(6, 2)
  bwProgram           Decimal   @default(0) @db.Decimal(6, 2)
  bwImplementation    Decimal   @default(0) @db.Decimal(6, 2)
  materialFactor      Decimal   @default(0) @db.Decimal(9, 4)
  labourFactor        Decimal   @default(0) @db.Decimal(9, 4)
  overheadFactor      Decimal   @default(0) @db.Decimal(9, 4)
  brainware           Decimal   @default(0) @db.Decimal(9, 4)
  tkdn                Decimal   @default(0) @db.Decimal(9, 4)
  /// DRAFT | FINAL
  status              String    @default("DRAFT") @db.VarChar(8)
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?   @db.Uuid
  updatedById         String?   @db.Uuid
  deletedAt           DateTime?

  lines TkdnAssessmentLine[]

  @@unique([companyId, number])
  @@index([companyId, productId])
  @@map("tkdn_assessments")
}

model TkdnAssessmentLine {
  id                   String   @id @default(uuid()) @db.Uuid
  assessmentId         String   @db.Uuid
  seq                  Int
  productId            String?  @db.Uuid
  description          String   @db.VarChar(200)
  specification        String?  @db.VarChar(200)
  uom                  String?  @db.VarChar(20)
  originCountry        String   @default("ID") @db.VarChar(3)
  qty                  Decimal  @db.Decimal(18, 4)
  unitPrice            Decimal  @db.Decimal(18, 2)
  /// component has a TKDN certificate and its value (%)
  hasCertificate       Boolean  @default(false)
  certTkdn             Decimal? @db.Decimal(6, 2)
  /// no certificate: made in Indonesia by an industrial company; and all of its own materials domestic / natural resource
  domesticProducer     Boolean  @default(false)
  allDomesticMaterials Boolean  @default(false)
  /// credited domestic share (Art. 5 (2)) and its contribution to the material factor
  creditPct            Decimal  @default(0) @db.Decimal(6, 2)
  share                Decimal  @default(0) @db.Decimal(9, 4)

  assessment TkdnAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("tkdn_assessment_lines")
}

/// B3 (hazardous) waste type per PP 22/2021 Annex IX (e.g. B105d used lubricating oil, category 2)
model WasteType {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  code              String    @db.VarChar(20)
  name              String    @db.VarChar(200)
  /// hazard category 1 | 2
  category          Int       @default(2)
  /// NON_SPECIFIC | EXPIRED | SPECIFIC_GENERAL | SPECIFIC_SPECIAL
  sourceType        String    @default("NON_SPECIFIC") @db.VarChar(20)
  /// explosive, flammable, reactive, infectious, corrosive, toxic
  characteristics   String?   @db.VarChar(200)
  /// generated at 50 kg a day or more: storage at most 90 days (Permen LHK 6/2021 Art. 79)
  atLeast50KgPerDay Boolean   @default(false)
  storageLocation   String?   @db.VarChar(150)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime?

  @@unique([companyId, code])
  @@map("waste_types")
}

/// B3 waste put into the temporary store (logbook "in", Permen LHK 6/2021 Annex IX form A)
model WasteEntry {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  wasteTypeId    String   @db.Uuid
  date           DateTime @db.Date
  source         String?  @db.VarChar(200)
  /// kilograms
  qty            Decimal  @db.Decimal(18, 3)
  remainingQty   Decimal  @db.Decimal(18, 3)
  storageDays    Int
  maxStorageDate DateTime @db.Date
  notes          String?  @db.VarChar(500)
  /// POSTED | CANCELLED
  status         String   @default("POSTED") @db.VarChar(10)
  createdAt      DateTime @default(now())
  createdById    String?  @db.Uuid

  @@index([companyId, wasteTypeId, date])
  @@map("waste_entries")
}

/// B3 waste leaving the store: handed to a licensed transporter / receiver with the Festronik manifest, or
/// utilised / treated / landfilled by the company itself
model WasteHandover {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @db.Uuid
  number        String   @db.VarChar(40)
  date          DateTime @db.Date
  /// HANDED_OVER | UTILISED | TREATED | LANDFILLED | EXPORTED | OTHER
  treatment     String   @db.VarChar(12)
  transporterId String?  @db.Uuid
  receiverId    String?  @db.Uuid
  manifestNo    String?  @db.VarChar(60)
  vehicleNo     String?  @db.VarChar(30)
  licenceNo     String?  @db.VarChar(100)
  notes         String?  @db.VarChar(500)
  /// POSTED | CANCELLED
  status        String   @default("POSTED") @db.VarChar(10)
  createdAt     DateTime @default(now())
  createdById   String?  @db.Uuid

  lines WasteHandoverLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("waste_handovers")
}

model WasteHandoverLine {
  id          String  @id @default(uuid()) @db.Uuid
  handoverId  String  @db.Uuid
  wasteTypeId String  @db.Uuid
  qty         Decimal @db.Decimal(18, 3)
  /// entries taken (first in, first out): [{ entryId, qty }]
  allocations Json    @default("[]")

  handover WasteHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)

  @@map("waste_handover_lines")
}

/// Quarterly SIINas report (Permenperin 13/2025): figures the ERP derives plus what is entered by hand
model SiinasReport {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  year        Int
  quarter     Int
  /// figures entered by hand (capacity, energy, water, investment...)
  inputs      Json      @default("{}")
  /// DRAFT | SUBMITTED
  status      String    @default("DRAFT") @db.VarChar(10)
  submittedAt DateTime?
  receiptNo   String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  updatedById String?   @db.Uuid

  @@unique([companyId, year, quarter])
  @@map("siinas_reports")
}

// ----------------------------------------------------------------------------
// Agribusiness: farms, livestock / aquaculture cycles, inti-plasma partnership
// ----------------------------------------------------------------------------

/// Farm: our own farm, or the farm of a plasma partner farmer (Permentan 13/2017 inti-plasma)
model FarmSite {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  branchId       String?   @db.Uuid
  code           String    @db.VarChar(30)
  name           String    @db.VarChar(150)
  /// LIVESTOCK | AQUACULTURE | PLANTATION | MIXED
  kind           String    @default("LIVESTOCK") @db.VarChar(12)
  /// OWN | PLASMA (farm of a partner farmer)
  ownership      String    @default("OWN") @db.VarChar(10)
  partnerId      String?   @db.Uuid
  address        String?
  regency        String?   @db.VarChar(100)
  /// livestock business registration / licence (Permentan 13/2017 Art. 10)
  registrationNo String?   @db.VarChar(100)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  @@unique([companyId, code])
  @@map("farm_sites")
}

/// House, pen, pond or cage of a farm
model FarmUnit {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  siteId      String    @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(150)
  /// HOUSE | PEN | POND | CAGE | OTHER
  kind        String    @default("HOUSE") @db.VarChar(10)
  capacity    Int       @default(0)
  areaM2      Decimal?  @db.Decimal(18, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("farm_units")
}

/// One production cycle (flock, batch, pond crop) of a population of animals counted by head
model LivestockCycle {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  branchId         String?   @db.Uuid
  number           String    @db.VarChar(40)
  siteId           String    @db.Uuid
  unitId           String    @db.Uuid
  /// BROILER | LAYER | BREEDER | DUCK | QUAIL | FISH | SHRIMP | OTHER
  species          String    @db.VarChar(10)
  strain           String?   @db.VarChar(100)
  /// PLANNED | ACTIVE | CLOSED | CANCELLED
  status           String    @default("PLANNED") @db.VarChar(10)
  /// GROWING | LAYING (layers, breeders, ducks, quail after the onset of lay)
  phase            String    @default("GROWING") @db.VarChar(8)
  placementDate    DateTime  @db.Date
  initialQty       Int
  /// age at placement in days (DOC 0, point-of-lay pullets ~ 112)
  initialAgeDays   Int       @default(0)
  warehouseId      String    @db.Uuid
  /// stock issued at placement (DOC, fry, pullets) and products received at harvest
  stockProductId   String?   @db.Uuid
  outputProductId  String?   @db.Uuid
  cullProductId    String?   @db.Uuid
  eggProductId     String?   @db.Uuid
  /// KG | PCS: how eggs are received into stock
  eggUnit          String    @default("KG") @db.VarChar(3)
  contractId       String?   @db.Uuid
  targetFcr        Decimal?  @db.Decimal(9, 3)
  targetWeightKg   Decimal?  @db.Decimal(9, 3)
  targetAgeDays    Int?
  /// laying phase: rearing cost capitalised at the onset of lay, written off over the laying period into the eggs
  layStartDate     DateTime? @db.Date
  expectedLayWeeks Int       @default(0)
  rearingCost      Decimal   @default(0) @db.Decimal(18, 2)
  rearingAmortised Decimal   @default(0) @db.Decimal(18, 2)
  amortisedTo      DateTime? @db.Date
  /// laying-phase costs not yet assigned to eggs
  layingPool       Decimal   @default(0) @db.Decimal(18, 2)
  mortality        Int       @default(0)
  culled           Int       @default(0)
  harvestedQty     Int       @default(0)
  harvestedKg      Decimal   @default(0) @db.Decimal(18, 3)
  feedKg           Decimal   @default(0) @db.Decimal(18, 3)
  eggsGood         Int       @default(0)
  eggsKg           Decimal   @default(0) @db.Decimal(18, 3)
  /// cost charged to the cycle and cost taken out (harvest, eggs, abnormal losses)
  costIn           Decimal   @default(0) @db.Decimal(18, 2)
  costOut          Decimal   @default(0) @db.Decimal(18, 2)
  abnormalLoss     Decimal   @default(0) @db.Decimal(18, 2)
  /// no harvest before this date: withdrawal period of the last medicine (waktu henti obat hewan)
  withdrawalUntil  DateTime? @db.Date
  closedAt         DateTime? @db.Date
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid

  daily      LivestockDaily[]
  treatments LivestockTreatment[]
  costs      LivestockCost[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([unitId])
  @@map("livestock_cycles")
}

/// Daily record of a cycle: depletion, feed, water, weight sample, eggs, climate / water quality
model LivestockDaily {
  id                String    @id @default(uuid()) @db.Uuid
  cycleId           String    @db.Uuid
  date              DateTime  @db.Date
  mortality         Int       @default(0)
  culled            Int       @default(0)
  /// mortality above normal (outbreak, heat stress...): its cost is written off as an abnormal loss
  abnormal          Boolean   @default(false)
  feedProductId     String?   @db.Uuid
  feedKg            Decimal   @default(0) @db.Decimal(18, 3)
  waterL            Decimal?  @db.Decimal(18, 2)
  avgWeightG        Decimal?  @db.Decimal(18, 2)
  sampleSize        Int?
  eggsGood          Int       @default(0)
  eggsCracked       Int       @default(0)
  eggsKg            Decimal   @default(0) @db.Decimal(18, 3)
  tempMin           Decimal?  @db.Decimal(6, 2)
  tempMax           Decimal?  @db.Decimal(6, 2)
  humidity          Decimal?  @db.Decimal(6, 2)
  /// aquaculture: { do, ph, salinity, tempC, ammonia, transparencyCm }
  waterQuality      Json?
  notes             String?   @db.VarChar(1000)
  feedCost          Decimal   @default(0) @db.Decimal(18, 2)
  lossValue         Decimal   @default(0) @db.Decimal(18, 2)
  eggCost           Decimal   @default(0) @db.Decimal(18, 2)
  amortisation      Decimal   @default(0) @db.Decimal(18, 2)
  poolBefore        Decimal   @default(0) @db.Decimal(18, 2)
  amortisedToBefore DateTime? @db.Date
  createdAt         DateTime  @default(now())
  createdById       String?   @db.Uuid

  cycle LivestockCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@unique([cycleId, date])
  @@map("livestock_daily")
}

/// Vaccination, medicine, vitamin or disinfectant given (or planned) to a cycle
model LivestockTreatment {
  id              String    @id @default(uuid()) @db.Uuid
  cycleId         String    @db.Uuid
  /// VACCINE | MEDICINE | VITAMIN | DISINFECTANT
  kind            String    @db.VarChar(12)
  /// PLANNED | DONE | CANCELLED
  status          String    @default("DONE") @db.VarChar(10)
  date            DateTime  @db.Date
  productId       String?   @db.Uuid
  description     String    @db.VarChar(200)
  qty             Decimal   @default(0) @db.Decimal(18, 4)
  cost            Decimal   @default(0) @db.Decimal(18, 2)
  /// drinking water, eye drop, injection, spray, feed...
  method          String?   @db.VarChar(40)
  withdrawalDays  Int       @default(0)
  withdrawalUntil DateTime? @db.Date
  vet             String?   @db.VarChar(120)
  notes           String?   @db.VarChar(500)
  createdAt       DateTime  @default(now())
  createdById     String?   @db.Uuid

  cycle LivestockCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, date])
  @@map("livestock_treatments")
}

/// Cost ledger of a cycle (positive = charged to it, negative = taken out of it)
model LivestockCost {
  id          String   @id @default(uuid()) @db.Uuid
  cycleId     String   @db.Uuid
  date        DateTime @db.Date
  /// STOCK | FEED | TREATMENT | LABOUR | OVERHEAD | LOSS | HARVEST | EGGS | WRITE_OFF
  kind        String   @db.VarChar(10)
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(18, 2)
  sourceType  String?  @db.VarChar(10)
  sourceId    String?  @db.Uuid
  createdAt   DateTime @default(now())

  cycle LivestockCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)

  @@index([cycleId, date])
  @@map("livestock_costs")
}

/// Harvest (or sale of culled layers) of a cycle into stock, optionally with a draft delivery to the buyer
model LivestockHarvest {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  cycleId     String    @db.Uuid
  number      String    @db.VarChar(40)
  date        DateTime  @db.Date
  /// HARVEST | CULL
  kind        String    @default("HARVEST") @db.VarChar(8)
  qty         Int
  weightKg    Decimal   @db.Decimal(18, 3)
  ageDays     Int
  productId   String    @db.Uuid
  warehouseId String    @db.Uuid
  customerId  String?   @db.Uuid
  pricePerKg  Decimal?  @db.Decimal(18, 2)
  /// optional fair value less costs to sell of the produce at harvest; empty = at cost
  fairValue   Decimal?  @db.Decimal(18, 2)
  cost        Decimal   @default(0) @db.Decimal(18, 2)
  deliveryNo  String?   @db.VarChar(60)
  vehicleNo   String?   @db.VarChar(30)
  /// harvest inside the withdrawal period: reason given
  overrideReason String?  @db.VarChar(300)
  deliveryDocId  String?  @db.Uuid
  notes       String?   @db.VarChar(500)
  /// POSTED | CANCELLED
  status      String    @default("POSTED") @db.VarChar(10)
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid

  @@unique([companyId, number])
  @@index([cycleId])
  @@map("livestock_harvests")
}

/// Inti-plasma partnership agreement with a farmer (Permentan 13/2017 Art. 11): contract prices of inputs and of the
/// harvest, bonuses, terms
model PartnerContract {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  number            String    @db.VarChar(40)
  partnerId         String    @db.Uuid
  siteId            String?   @db.Uuid
  species           String    @default("BROILER") @db.VarChar(10)
  startDate         DateTime  @db.Date
  endDate           DateTime? @db.Date
  /// per head of DOC / fry supplied
  docPrice          Decimal   @default(0) @db.Decimal(18, 2)
  /// [{ productId, price }] per kg of feed supplied
  feedPrices        Json      @default("[]")
  /// medicines, vaccines charged at our cost plus this mark-up
  medicineMarkupPct Decimal   @default(0) @db.Decimal(9, 4)
  /// harvest price per kg by average live weight: [{ minKg, maxKg, price }]
  priceBands        Json      @default("[]")
  standardFcr       Decimal?  @db.Decimal(9, 3)
  /// Rp per kg harvested for each 0.01 of FCR better than the standard
  fcrBonusPerPoint  Decimal   @default(0) @db.Decimal(18, 2)
  ipThreshold       Decimal?  @db.Decimal(9, 2)
  ipBonusPerKg      Decimal   @default(0) @db.Decimal(18, 2)
  /// collect PPh 22 0.25% when buying the harvest (industry / exporter buyer, PMK 51/2025)
  withholdPph22     Boolean   @default(false)
  /// loss of earlier cycles still owed by the farmer, deducted from the next settlement
  carryForward      Decimal   @default(0) @db.Decimal(18, 2)
  terms             String?
  /// acknowledged by the regency / city government (Art. 11 (3))
  acknowledgedBy    String?   @db.VarChar(150)
  acknowledgedAt    DateTime? @db.Date
  /// ACTIVE | ENDED
  status            String    @default("ACTIVE") @db.VarChar(8)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  updatedById       String?   @db.Uuid
  deletedAt         DateTime?

  @@unique([companyId, number])
  @@map("partner_contracts")
}

/// Settlement of a plasma cycle (rekapitulasi hasil pemeliharaan, RHPP)
model PartnerSettlement {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  number         String    @db.VarChar(40)
  contractId     String    @db.Uuid
  cycleId        String    @db.Uuid
  date           DateTime  @db.Date
  harvestQty     Int
  harvestKg      Decimal   @db.Decimal(18, 3)
  avgWeightKg    Decimal   @db.Decimal(9, 3)
  pricePerKg     Decimal   @db.Decimal(18, 2)
  revenue        Decimal   @db.Decimal(18, 2)
  docCharge      Decimal   @db.Decimal(18, 2)
  feedCharge     Decimal   @db.Decimal(18, 2)
  medicineCharge Decimal   @db.Decimal(18, 2)
  fcr            Decimal   @db.Decimal(9, 3)
  ip             Decimal   @db.Decimal(9, 2)
  fcrBonus       Decimal   @db.Decimal(18, 2)
  ipBonus        Decimal   @db.Decimal(18, 2)
  deductions     Decimal   @default(0) @db.Decimal(18, 2)
  carriedIn      Decimal   @default(0) @db.Decimal(18, 2)
  net            Decimal   @db.Decimal(18, 2)
  invoiceId      String?   @db.Uuid
  notes          String?   @db.VarChar(1000)
  /// POSTED | CANCELLED
  status         String    @default("POSTED") @db.VarChar(10)
  createdAt      DateTime  @default(now())
  createdById    String?   @db.Uuid

  @@unique([companyId, number])
  @@index([cycleId])
  @@map("partner_settlements")
}

// ----------------------------------------------------------------------------
// Plantations: estate (farm site of kind PLANTATION) -> division (afdeling) -> block,
// daily work book (BKM / checkroll), FFB dispatch (SPB) and weighbridge
// ----------------------------------------------------------------------------

/// Division (afdeling) of a plantation estate
model PlantationDivision {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  siteId      String    @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(150)
  /// division assistant (asisten afdeling)
  assistantId String?   @db.Uuid
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("plantation_divisions")
}

/// Planted block (blok) of a division
model PlantationBlock {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  branchId        String?   @db.Uuid
  siteId          String    @db.Uuid
  divisionId      String    @db.Uuid
  code            String    @db.VarChar(30)
  name            String?   @db.VarChar(150)
  /// OIL_PALM | RUBBER | COCOA | COFFEE | COCONUT | TEA | SUGARCANE | OTHER
  crop            String    @default("OIL_PALM") @db.VarChar(12)
  variety         String?   @db.VarChar(100)
  plantingYear    Int?
  plantingDate    DateTime? @db.Date
  areaHa          Decimal   @default(0) @db.Decimal(12, 4)
  /// palms / trees standing (pokok)
  stands          Int       @default(0)
  /// TBM (immature) | TM (mature) | INACTIVE
  phase           String    @default("TBM") @db.VarChar(10)
  matureDate      DateTime? @db.Date
  /// expected average bunch weight (BJR, kg) used to estimate the weight at the collection point
  bjrKg           Decimal   @default(0) @db.Decimal(8, 2)
  /// land title (HGU / SHM / STDB number)
  landTitle       String?   @db.VarChar(100)
  /// plot boundary as GeoJSON (Polygon / MultiPolygon, WGS84) and its centre: traceability (EUDR, ISPO)
  geometry        Json?
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  /// cost capitalised while immature (bearer plants not yet productive)
  tbmCost         Decimal   @default(0) @db.Decimal(18, 2)
  /// fixed asset (bearer plants, mature) created when the block is declared mature
  fixedAssetId    String?   @db.Uuid
  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdById     String?   @db.Uuid
  updatedById     String?   @db.Uuid
  deletedAt       DateTime?

  @@unique([companyId, code])
  @@index([divisionId])
  @@map("plantation_blocks")
}

/// Field activity with its wage rule (harvesting, weeding, fertilising, spraying...)
model PlantationActivity {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(150)
  /// HARVEST | UPKEEP | FERTILISING | PEST | PLANTING | INFRA | TRANSPORT | GENERAL
  kind             String    @default("UPKEEP") @db.VarChar(12)
  /// output unit: HA | BUNCH | KG | PALM | M | TRIP | HK
  uom              String    @default("HA") @db.VarChar(10)
  /// DAILY: paid per work day (HK) plus a premium above the base task; PIECE: paid per unit of output
  wageBasis        String    @default("DAILY") @db.VarChar(6)
  dailyRate        Decimal   @default(0) @db.Decimal(18, 2)
  pieceRate        Decimal   @default(0) @db.Decimal(18, 2)
  /// base task per HK (basis borong) covered by the daily wage
  baseTask         Decimal   @default(0) @db.Decimal(12, 2)
  /// premium per unit above the base task
  premiumRate      Decimal   @default(0) @db.Decimal(18, 2)
  /// harvest grading penalties (per bunch / per case)
  penaltyUnripe    Decimal   @default(0) @db.Decimal(18, 2)
  penaltyLongStalk Decimal   @default(0) @db.Decimal(18, 2)
  penaltyLooseLeft Decimal   @default(0) @db.Decimal(18, 2)
  penaltyOther     Decimal   @default(0) @db.Decimal(18, 2)
  /// cost account for mature blocks (default by kind)
  expenseAccountId String?   @db.Uuid
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  @@unique([companyId, code])
  @@map("plantation_activities")
}

/// Daily work book of a foreman (Buku Kegiatan Mandor, BKM) for one division
model PlantationWorkday {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  branchId      String?   @db.Uuid
  number        String    @db.VarChar(40)
  siteId        String    @db.Uuid
  divisionId    String    @db.Uuid
  date          DateTime  @db.Date
  foremanId     String?   @db.Uuid
  /// DRAFT | APPROVED | CANCELLED
  status        String    @default("DRAFT") @db.VarChar(10)
  /// store the materials are issued from
  warehouseId   String?   @db.Uuid
  totalHk       Decimal   @default(0) @db.Decimal(10, 2)
  totalWage     Decimal   @default(0) @db.Decimal(18, 2)
  totalMaterial Decimal   @default(0) @db.Decimal(18, 2)
  notes         String?
  approvedAt    DateTime?
  approvedById  String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  works     PlantationWork[]
  materials PlantationMaterial[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("plantation_workdays")
}

/// Work of one worker on one block in a BKM
model PlantationWork {
  id           String   @id @default(uuid()) @db.Uuid
  /// order of entry
  lineNo       Int      @default(0)
  workdayId    String   @db.Uuid
  companyId    String   @db.Uuid
  date         DateTime @db.Date
  employeeId   String   @db.Uuid
  blockId      String   @db.Uuid
  activityId   String   @db.Uuid
  hk           Decimal  @default(1) @db.Decimal(4, 2)
  qty          Decimal  @default(0) @db.Decimal(14, 2)
  /// harvesting: collection point (TPH), bunches, loose fruit and grading findings
  tph          String?  @db.VarChar(20)
  bunches      Int      @default(0)
  looseFruitKg Decimal  @default(0) @db.Decimal(10, 2)
  unripe       Int      @default(0)
  longStalk    Int      @default(0)
  looseLeft    Int      @default(0)
  otherFaults  Int      @default(0)
  wage         Decimal  @default(0) @db.Decimal(18, 2)
  premium      Decimal  @default(0) @db.Decimal(18, 2)
  penalty      Decimal  @default(0) @db.Decimal(18, 2)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  /// cost capitalised to an immature block (TBM)
  capitalised  Boolean  @default(false)
  /// payroll run that paid this work
  payrollRunId String?  @db.Uuid
  notes        String?  @db.VarChar(300)

  workday PlantationWorkday @relation(fields: [workdayId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, date])
  @@index([blockId, date])
  @@map("plantation_works")
}

/// Fertiliser, chemicals and other materials used on a block in a BKM
model PlantationMaterial {
  id          String   @id @default(uuid()) @db.Uuid
  /// order of entry
  lineNo       Int      @default(0)
  workdayId   String   @db.Uuid
  companyId   String   @db.Uuid
  date        DateTime @db.Date
  blockId     String   @db.Uuid
  activityId  String?  @db.Uuid
  productId   String   @db.Uuid
  qty         Decimal  @db.Decimal(14, 3)
  amount      Decimal  @default(0) @db.Decimal(18, 2)
  capitalised Boolean  @default(false)

  workday PlantationWorkday @relation(fields: [workdayId], references: [id], onDelete: Cascade)

  @@index([blockId, date])
  @@map("plantation_materials")
}

/// FFB transport note (Surat Pengantar Buah, SPB) and its weighbridge ticket
model FfbDispatch {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  branchId      String?   @db.Uuid
  number        String    @db.VarChar(40)
  date          DateTime  @db.Date
  siteId        String    @db.Uuid
  divisionId    String?   @db.Uuid
  vehicleNo     String?   @db.VarChar(20)
  driver        String?   @db.VarChar(100)
  /// mill buying the fruit (none: own mill / not sold yet)
  customerId    String?   @db.Uuid
  productId     String    @db.Uuid
  warehouseId   String    @db.Uuid
  /// DRAFT (on the road) | WEIGHED | CANCELLED
  status        String    @default("DRAFT") @db.VarChar(10)
  ticketNo      String?   @db.VarChar(40)
  weighedAt     DateTime?
  grossKg       Decimal   @default(0) @db.Decimal(14, 2)
  tareKg        Decimal   @default(0) @db.Decimal(14, 2)
  netKg         Decimal   @default(0) @db.Decimal(14, 2)
  /// sorting deduction at the mill (potongan sortasi)
  sortingPct    Decimal   @default(0) @db.Decimal(6, 2)
  sortingKg     Decimal   @default(0) @db.Decimal(14, 2)
  /// grading sample behind the sorting deduction (Permentan 13/2024 Lampiran II): percentages found
  grading       Json?
  acceptedKg    Decimal   @default(0) @db.Decimal(14, 2)
  /// price per kg agreed with the mill; also the fair value less costs to sell at harvest
  pricePerKg    Decimal   @default(0) @db.Decimal(18, 2)
  amount        Decimal   @default(0) @db.Decimal(18, 2)
  deliveryDocId String?   @db.Uuid
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  lines FfbDispatchLine[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("ffb_dispatches")
}

/// Fruit loaded from one block / collection point
model FfbDispatchLine {
  id           String  @id @default(uuid()) @db.Uuid
  /// order of entry
  lineNo       Int      @default(0)
  dispatchId   String  @db.Uuid
  blockId      String  @db.Uuid
  tph          String? @db.VarChar(20)
  bunches      Int     @default(0)
  looseFruitKg Decimal @default(0) @db.Decimal(10, 2)
  /// bunches x BJR of the block + loose fruit
  estimatedKg  Decimal @default(0) @db.Decimal(14, 2)
  /// accepted weight allocated back from the weighbridge in proportion to the estimate
  actualKg     Decimal @default(0) @db.Decimal(14, 2)

  dispatch FfbDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  @@index([blockId])
  @@map("ffb_dispatch_lines")
}

// ----------------------------------------------------------------------------
// Palm oil mill (PKS): fruit bought from third parties at the weighbridge, TBS price board,
// storage tanks with their calibration table, daily processing report (OER / KER, joint cost)
// ----------------------------------------------------------------------------

/// Storage tank (CPO) or bulk store (kernel silo / bunker) of the mill
model MillTank {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  code        String    @db.VarChar(30)
  name        String    @db.VarChar(150)
  /// CPO (measured by sounding) | KERNEL | OTHER (stock entered in kg)
  kind        String    @default("CPO") @db.VarChar(8)
  productId   String    @db.Uuid
  warehouseId String    @db.Uuid
  capacityKg  Decimal   @default(0) @db.Decimal(14, 2)
  /// calibration table (tabel tera): [{ cm, litres }] ascending
  calibration Json?
  /// reference temperature of the calibration table (°C)
  calibrationTempC Decimal @default(0) @db.Decimal(5, 2)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@unique([companyId, code])
  @@map("mill_tanks")
}

/// TBS purchase price from a date by kind of supplier (price board / Disbun price for partner smallholders)
model MillTbsPrice {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  effectiveDate DateTime  @db.Date
  /// MITRA (partner smallholder, Permentan 13/2024) | SWADAYA (independent smallholder) | AGENT (dealer / collector) | ESTATE (other company)
  supplierType  String    @db.VarChar(8)
  pricePerKg    Decimal   @db.Decimal(18, 2)
  /// Permentan 13/2024 formula inputs (partner smallholders): HTBS = K x (HCPO x RCPO + HPK x RPK) + shell value
  kIndex        Decimal?  @db.Decimal(8, 4)
  cpoPrice      Decimal?  @db.Decimal(18, 2)
  kernelPrice   Decimal?  @db.Decimal(18, 2)
  cpoYield      Decimal?  @db.Decimal(6, 3)
  kernelYield   Decimal?  @db.Decimal(6, 3)
  shellValue    Decimal?  @db.Decimal(18, 2)
  /// palm age band or region the price applies to (free text, e.g. "10-20 th, Riau")
  scope         String?   @db.VarChar(100)
  reference     String?   @db.VarChar(150)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid
  deletedAt     DateTime?

  @@index([companyId, supplierType, effectiveDate])
  @@map("mill_tbs_prices")
}

/// Fruit bought at the mill weighbridge from a third party (smallholder, dealer, other estate)
model MillIntake {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  branchId      String?   @db.Uuid
  number        String    @db.VarChar(40)
  date          DateTime  @db.Date
  weighedAt     DateTime
  supplierId    String    @db.Uuid
  supplierType  String    @db.VarChar(8)
  /// origin of the fruit (village / plot / STDB) for traceability
  origin        String?   @db.VarChar(150)
  vehicleNo     String?   @db.VarChar(20)
  driver        String?   @db.VarChar(100)
  ticketNo      String?   @db.VarChar(40)
  bunches       Int       @default(0)
  grossKg       Decimal   @db.Decimal(14, 2)
  tareKg        Decimal   @db.Decimal(14, 2)
  netKg         Decimal   @db.Decimal(14, 2)
  grading       Json?
  sortingPct    Decimal   @default(0) @db.Decimal(6, 2)
  sortingKg     Decimal   @default(0) @db.Decimal(14, 2)
  acceptedKg    Decimal   @db.Decimal(14, 2)
  pricePerKg    Decimal   @db.Decimal(18, 2)
  priceId       String?   @db.Uuid
  amount        Decimal   @db.Decimal(18, 2)
  productId     String    @db.Uuid
  warehouseId   String    @db.Uuid
  /// POSTED | CANCELLED
  status        String    @default("POSTED") @db.VarChar(10)
  /// goods receipt that put the fruit in stock (Dr Inventory / Cr GRNI)
  receiptDocId  String?   @db.Uuid
  /// supplier invoice that settled it
  invoiceDocId  String?   @db.Uuid
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid

  @@unique([companyId, number])
  @@index([companyId, date])
  @@index([supplierId, date])
  @@map("mill_intakes")
}

/// Daily processing report of the mill
model MillDaily {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  branchId         String?   @db.Uuid
  number           String    @db.VarChar(40)
  date             DateTime  @db.Date
  /// DRAFT | POSTED | CANCELLED
  status           String    @default("DRAFT") @db.VarChar(10)
  tbsProductId     String    @db.Uuid
  tbsWarehouseId   String    @db.Uuid
  /// fruit at the loading ramp at the start of the day (restan), received and processed
  tbsOpeningKg     Decimal   @default(0) @db.Decimal(14, 2)
  tbsReceivedKg    Decimal   @default(0) @db.Decimal(14, 2)
  tbsProcessedKg   Decimal   @default(0) @db.Decimal(14, 2)
  processingHours  Decimal   @default(0) @db.Decimal(6, 2)
  breakdownHours   Decimal   @default(0) @db.Decimal(6, 2)
  /// processing cost charged to the products (labour, fuel, power, maintenance of the mill), credited to overhead applied
  conversionCost   Decimal   @default(0) @db.Decimal(18, 2)
  tbsCost          Decimal   @default(0) @db.Decimal(18, 2)
  /// quality and losses: { cpoFfa, cpoMoisture, cpoDirt, cpoDobi, kernelMoisture, kernelDirt, kernelBroken, lossFibre, lossEfb, lossNut, lossEffluent, lossKernel }
  quality          Json?
  notes            String?
  postedAt         DateTime?
  postedById       String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  outputs   MillDailyOutput[]
  soundings MillSounding[]

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("mill_dailies")
}

/// Product made on the day: main products (CPO, kernel) share the joint cost by sales value, by-products at net realisable value
model MillDailyOutput {
  id          String  @id @default(uuid()) @db.Uuid
  dailyId     String  @db.Uuid
  lineNo      Int     @default(0)
  productId   String  @db.Uuid
  warehouseId String  @db.Uuid
  /// MAIN | BY
  kind        String  @default("MAIN") @db.VarChar(4)
  qty         Decimal @db.Decimal(14, 2)
  /// sales price per kg (main) or net realisable value per kg (by-product)
  price       Decimal @default(0) @db.Decimal(18, 2)
  cost        Decimal @default(0) @db.Decimal(18, 2)

  daily MillDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@index([dailyId])
  @@map("mill_daily_outputs")
}

/// Closing stock of a tank at the end of the day (sounding)
model MillSounding {
  id          String   @id @default(uuid()) @db.Uuid
  dailyId     String   @db.Uuid
  tankId      String   @db.Uuid
  heightCm    Decimal? @db.Decimal(8, 2)
  temperatureC Decimal? @db.Decimal(5, 2)
  volumeL     Decimal? @db.Decimal(14, 2)
  density     Decimal? @db.Decimal(8, 5)
  kg          Decimal  @db.Decimal(14, 2)
  ffa         Decimal? @db.Decimal(5, 2)

  daily MillDaily @relation(fields: [dailyId], references: [id], onDelete: Cascade)

  @@unique([dailyId, tankId])
  @@map("mill_soundings")
}

// ----------------------------------------------------------------------------
// Herd: cattle / buffalo / goats / sheep kept by head (breeding, dairy, fattening),
// weighings, reproduction, health, feeding by pen, milk recording and deliveries, exits
// ----------------------------------------------------------------------------

/// One animal of the herd, identified by its ear tag
model Animal {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  branchId           String?   @db.Uuid
  tagNo              String    @db.VarChar(40)
  /// national livestock ID / registration (iSIKHNAS) or RFID
  nationalId         String?   @db.VarChar(60)
  name               String?   @db.VarChar(100)
  /// CATTLE | BUFFALO | GOAT | SHEEP
  species            String    @default("CATTLE") @db.VarChar(8)
  breed              String?   @db.VarChar(80)
  /// F | M
  sex                String    @db.VarChar(1)
  /// DAIRY | BREEDING | FATTENING
  purpose            String    @db.VarChar(10)
  birthDate          DateTime? @db.Date
  birthWeightKg      Decimal?  @db.Decimal(8, 2)
  /// BORN | PURCHASED | OPENING
  origin             String    @db.VarChar(10)
  damId              String?   @db.Uuid
  /// sire: bull tag or semen code (straw)
  sire               String?   @db.VarChar(60)
  siteId             String    @db.Uuid
  unitId             String?   @db.Uuid
  /// ACTIVE | SOLD | DEAD | CULLED
  status             String    @default("ACTIVE") @db.VarChar(8)
  /// reproduction: OPEN | SERVED | PREGNANT
  reproStatus        String    @default("OPEN") @db.VarChar(8)
  lactating          Boolean   @default(false)
  lactationNo        Int       @default(0)
  lastCalving        DateTime? @db.Date
  lastService        DateTime? @db.Date
  servicesSinceCalving Int     @default(0)
  expectedCalving    DateTime? @db.Date
  dryOffDate         DateTime? @db.Date
  lastWeightKg       Decimal?  @db.Decimal(8, 2)
  lastWeighDate      DateTime? @db.Date
  /// drugs: milk / meat may not be sold before these dates
  milkWithdrawalUntil DateTime? @db.Date
  meatWithdrawalUntil DateTime? @db.Date
  acquisitionDate    DateTime  @db.Date
  acquisitionCost    Decimal   @default(0) @db.Decimal(18, 2)
  supplierId         String?   @db.Uuid
  purchaseDocId      String?   @db.Uuid
  /// cost carried while growing / fattening (biological asset at cost)
  carryingCost       Decimal   @default(0) @db.Decimal(18, 2)
  /// productive animal (cow in milk / breeding cow or bull): fixed asset depreciated over its productive life
  fixedAssetId       String?   @db.Uuid
  productiveDate     DateTime? @db.Date
  exitDate           DateTime? @db.Date
  exitReason         String?   @db.VarChar(150)
  exitWeightKg       Decimal?  @db.Decimal(8, 2)
  exitValue          Decimal?  @db.Decimal(18, 2)
  exitCost           Decimal?  @db.Decimal(18, 2)
  saleDocId          String?   @db.Uuid
  customerId         String?   @db.Uuid
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid
  deletedAt          DateTime?

  @@unique([companyId, tagNo])
  @@index([companyId, status])
  @@index([unitId])
  @@map("animals")
}

model AnimalWeight {
  id        String   @id @default(uuid()) @db.Uuid
  animalId  String   @db.Uuid
  date      DateTime @db.Date
  kg        Decimal  @db.Decimal(8, 2)
  /// body condition score (1-5)
  bcs       Decimal? @db.Decimal(3, 1)
  notes     String?  @db.VarChar(300)
  createdAt DateTime @default(now())
  createdById String? @db.Uuid

  @@index([animalId, date])
  @@map("animal_weights")
}

/// Reproduction and other events of an animal
model AnimalEvent {
  id          String   @id @default(uuid()) @db.Uuid
  animalId    String   @db.Uuid
  date        DateTime @db.Date
  /// HEAT | SERVICE | PREG_CHECK | CALVING | ABORTION | DRY_OFF | MOVE | PRODUCTIVE | NOTE
  type        String   @db.VarChar(10)
  /// service: AI | NATURAL; calving: NORMAL | ASSISTED | CAESAREAN
  method      String?  @db.VarChar(10)
  /// bull tag / semen code
  sire        String?  @db.VarChar(60)
  /// inseminator / vet
  technician  String?  @db.VarChar(100)
  /// pregnancy check: POSITIVE | NEGATIVE; calving: LIVE | STILLBORN
  result      String?  @db.VarChar(10)
  fromUnitId  String?  @db.Uuid
  toUnitId    String?  @db.Uuid
  /// calves born (ids), other details
  data        Json?
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@index([animalId, date])
  @@map("animal_events")
}

/// Vaccination / treatment of an animal (product from stock, withdrawal periods)
model AnimalTreatment {
  id                 String    @id @default(uuid()) @db.Uuid
  animalId           String    @db.Uuid
  companyId          String    @db.Uuid
  date               DateTime  @db.Date
  /// VACCINE | MEDICINE | VITAMIN | DEWORMING | OTHER
  kind               String    @db.VarChar(10)
  description        String    @db.VarChar(200)
  /// disease / diagnosis (PMK, LSD, mastitis...)
  diagnosis          String?   @db.VarChar(150)
  productId          String?   @db.Uuid
  qty                Decimal   @default(0) @db.Decimal(14, 4)
  cost               Decimal   @default(0) @db.Decimal(18, 2)
  milkWithdrawalDays Int       @default(0)
  meatWithdrawalDays Int       @default(0)
  vet                String?   @db.VarChar(100)
  /// treatments given together (one stock issue) share a batch
  batchId            String    @db.Uuid
  notes              String?   @db.VarChar(500)
  createdAt          DateTime  @default(now())
  createdById        String?   @db.Uuid

  @@index([animalId, date])
  @@index([batchId])
  @@map("animal_treatments")
}

/// Cost charged to an animal (feed, health, rearing): capitalised while growing, expensed once productive
model AnimalCost {
  id          String   @id @default(uuid()) @db.Uuid
  animalId    String   @db.Uuid
  date        DateTime @db.Date
  /// PURCHASE | FEED | HEALTH | OTHER
  kind        String   @db.VarChar(10)
  amount      Decimal  @db.Decimal(18, 2)
  capitalised Boolean  @default(true)
  sourceType  String   @db.VarChar(10)
  sourceId    String   @db.Uuid
  createdAt   DateTime @default(now())

  @@index([animalId, date])
  @@index([sourceId])
  @@map("animal_costs")
}

/// Feed given to a pen, its cost shared by the animals in it
model HerdFeeding {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  branchId    String?   @db.Uuid
  number      String    @db.VarChar(40)
  date        DateTime  @db.Date
  unitId      String    @db.Uuid
  productId   String    @db.Uuid
  warehouseId String    @db.Uuid
  qty         Decimal   @db.Decimal(14, 3)
  cost        Decimal   @default(0) @db.Decimal(18, 2)
  heads       Int       @default(0)
  /// POSTED | CANCELLED
  status      String    @default("POSTED") @db.VarChar(10)
  notes       String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("herd_feedings")
}

/// Milk of one cow at one milking
model MilkRecord {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  animalId    String   @db.Uuid
  date        DateTime @db.Date
  /// AM | PM
  session     String   @db.VarChar(2)
  liters      Decimal  @db.Decimal(8, 2)
  /// milk under a drug withdrawal period, thrown away
  discarded   Boolean  @default(false)
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid

  @@unique([animalId, date, session])
  @@index([companyId, date])
  @@map("milk_records")
}

/// Milk price of a buyer from a date: base price adjusted for fat, total solids and bacteria count
model MilkPriceScheme {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  customerId    String    @db.Uuid
  effectiveDate DateTime  @db.Date
  basePrice     Decimal   @db.Decimal(18, 2)
  fatStd        Decimal   @default(0) @db.Decimal(5, 2)
  /// price change per 0.1 % fat above / below the standard
  fatStep       Decimal   @default(0) @db.Decimal(18, 2)
  tsStd         Decimal   @default(0) @db.Decimal(5, 2)
  tsStep        Decimal   @default(0) @db.Decimal(18, 2)
  /// [{ maxTpc, adj }] ascending by maxTpc (CFU/ml); above the last grade: rejectAbove or the last adj
  tpcGrades     Json?
  notes         String?   @db.VarChar(300)
  createdAt     DateTime  @default(now())
  createdById   String?   @db.Uuid
  deletedAt     DateTime?

  @@index([companyId, customerId, effectiveDate])
  @@map("milk_price_schemes")
}

/// Milk handed over to a buyer (KUD / milk processor) with its quality test and price
model MilkDelivery {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  branchId     String?   @db.Uuid
  number       String    @db.VarChar(40)
  date         DateTime  @db.Date
  /// AM | PM | DAY
  session      String    @default("DAY") @db.VarChar(3)
  customerId   String    @db.Uuid
  liters       Decimal   @db.Decimal(12, 2)
  fat          Decimal?  @db.Decimal(5, 2)
  snf          Decimal?  @db.Decimal(5, 2)
  ts           Decimal?  @db.Decimal(5, 2)
  protein      Decimal?  @db.Decimal(5, 2)
  /// total plate count (CFU / ml)
  tpc          Decimal?  @db.Decimal(14, 0)
  density      Decimal?  @db.Decimal(6, 4)
  alcoholTest  Boolean?
  rejected     Boolean   @default(false)
  pricePerLiter Decimal  @default(0) @db.Decimal(18, 2)
  priceDetail  Json?
  amount       Decimal   @default(0) @db.Decimal(18, 2)
  /// POSTED | CANCELLED
  status       String    @default("POSTED") @db.VarChar(10)
  invoiceDocId String?   @db.Uuid
  notes        String?   @db.VarChar(500)
  createdAt    DateTime  @default(now())
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid

  @@unique([companyId, number])
  @@index([companyId, date])
  @@map("milk_deliveries")
}

// ----------------------------------------------------------------------------
// Commodity sales (CPO, palm kernel, PKO...): contracts (direct, KPBN tender, export), deliveries with quality claims,
// export shipments with duty, levy and export proceeds (DHE)
// ----------------------------------------------------------------------------

/// Sales contract of a bulk commodity
model CommodityContract {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  branchId      String?   @db.Uuid
  number        String    @db.VarChar(40)
  /// buyer / tender contract number
  buyerRef      String?   @db.VarChar(60)
  date          DateTime  @db.Date
  customerId    String    @db.Uuid
  productId     String    @db.Uuid
  /// DOMESTIC | EXPORT
  market        String    @db.VarChar(8)
  /// DIRECT | TENDER (KPBN)
  channel       String    @default("DIRECT") @db.VarChar(8)
  /// FRANCO | LOCO | FOB | CFR | CIF
  incoterm      String    @db.VarChar(6)
  deliveryPoint String?   @db.VarChar(150)
  qtyKg         Decimal   @db.Decimal(16, 2)
  tolerancePct  Decimal   @default(0) @db.Decimal(5, 2)
  currencyCode  String    @default("IDR") @db.VarChar(3)
  /// price per kg (IDR contracts) or per metric ton (export), excluding PPN
  price         Decimal   @db.Decimal(18, 4)
  /// KG | MT
  priceUnit     String    @default("KG") @db.VarChar(2)
  taxId         String?   @db.Uuid
  deliveryFrom  DateTime? @db.Date
  deliveryTo    DateTime? @db.Date
  /// quality: { ffaMax, miMax, dobiMin }
  spec          Json?
  /// claims: { ffaRatePct, miDeductWeight, dobiRatePct }
  claims        Json?
  paymentTerms  String?   @db.VarChar(150)
  /// OPEN | COMPLETED | CANCELLED
  status        String    @default("OPEN") @db.VarChar(10)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("commodity_contracts")
}

/// Commodity loaded for a contract (truck, barge or vessel) with its quality and claim
model CommodityDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  contractId    String    @db.Uuid
  number        String    @db.VarChar(40)
  date          DateTime  @db.Date
  warehouseId   String    @db.Uuid
  /// truck plate / barge / vessel
  vehicle       String?   @db.VarChar(60)
  sealNo        String?   @db.VarChar(60)
  qtyKg         Decimal   @db.Decimal(16, 2)
  ffa           Decimal?  @db.Decimal(5, 2)
  mi            Decimal?  @db.Decimal(5, 2)
  dobi          Decimal?  @db.Decimal(5, 2)
  claimPct      Decimal   @default(0) @db.Decimal(7, 4)
  claimKg       Decimal   @default(0) @db.Decimal(14, 2)
  invoiceKg     Decimal   @db.Decimal(16, 2)
  /// price after the quality claim, in the contract currency and unit
  unitPrice     Decimal   @db.Decimal(18, 4)
  amount        Decimal   @db.Decimal(18, 2)
  shipmentId    String?   @db.Uuid
  deliveryDocId String?   @db.Uuid
  invoiceDocId  String?   @db.Uuid
  /// POSTED | CANCELLED
  status        String    @default("POSTED") @db.VarChar(10)
  notes         String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  createdById   String?   @db.Uuid
  updatedById   String?   @db.Uuid

  @@unique([companyId, number])
  @@index([contractId])
  @@map("commodity_deliveries")
}

/// Reference price, export duty and levy of a month for a product (from the Kemendag / Kemenkeu announcements)
model ExportReference {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  /// YYYY-MM
  month        String    @db.VarChar(7)
  productId    String    @db.Uuid
  refPriceUsd  Decimal   @db.Decimal(14, 2)
  dutyUsdPerMt Decimal   @default(0) @db.Decimal(14, 2)
  levyPct      Decimal?  @db.Decimal(6, 3)
  levyUsdPerMt Decimal?  @db.Decimal(14, 2)
  reference    String?   @db.VarChar(200)
  createdAt    DateTime  @default(now())
  createdById  String?   @db.Uuid
  deletedAt    DateTime?

  @@index([companyId, productId, month])
  @@map("export_references")
}

/// Export shipment (one PEB): documents, export duty, levy and the export proceeds
model ExportShipment {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @db.Uuid
  branchId           String?   @db.Uuid
  number             String    @db.VarChar(40)
  contractId         String    @db.Uuid
  pebNo              String?   @db.VarChar(40)
  pebDate            DateTime? @db.Date
  npeNo              String?   @db.VarChar(40)
  npeDate            DateTime? @db.Date
  vessel             String?   @db.VarChar(100)
  blNo               String?   @db.VarChar(60)
  blDate             DateTime? @db.Date
  portOfLoading      String?   @db.VarChar(100)
  portOfDischarge    String?   @db.VarChar(100)
  destinationCountry String?   @db.VarChar(3)
  hsCode             String?   @db.VarChar(12)
  /// surveyor report (LS), certificate of origin (SKA / COO), sustainability (ISPO / RSPO), EUDR due diligence reference
  surveyorReport     String?   @db.VarChar(60)
  originCertificate  String?   @db.VarChar(60)
  sustainabilityRef  String?   @db.VarChar(100)
  eudrRef            String?   @db.VarChar(100)
  qtyKg              Decimal   @default(0) @db.Decimal(16, 2)
  fobUsd             Decimal   @default(0) @db.Decimal(18, 2)
  referenceId        String?   @db.Uuid
  refPriceUsd        Decimal   @default(0) @db.Decimal(14, 2)
  dutyUsdPerMt       Decimal   @default(0) @db.Decimal(14, 2)
  levyUsdPerMt       Decimal   @default(0) @db.Decimal(14, 2)
  /// rate used for the duty and levy (Nilai Dasar Perhitungan / kurs)
  rate               Decimal   @default(0) @db.Decimal(14, 4)
  dutyIdr            Decimal   @default(0) @db.Decimal(18, 2)
  levyIdr            Decimal   @default(0) @db.Decimal(18, 2)
  dutyBilling        String?   @db.VarChar(60)
  levyBilling        String?   @db.VarChar(60)
  /// export proceeds (DHE): received, bank, retained until
  dheReceivedDate    DateTime? @db.Date
  dheReceivedUsd     Decimal?  @db.Decimal(18, 2)
  dheBank            String?   @db.VarChar(100)
  dheRetainedUsd     Decimal?  @db.Decimal(18, 2)
  dheRetainUntil     DateTime? @db.Date
  /// DRAFT | SHIPPED | CANCELLED
  status             String    @default("DRAFT") @db.VarChar(10)
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdById        String?   @db.Uuid
  updatedById        String?   @db.Uuid

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("export_shipments")
}
