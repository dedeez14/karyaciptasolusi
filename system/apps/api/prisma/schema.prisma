/// One business found on Google Maps (deduplicated per company by place id / cid)
model MapPlace {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  jobId          String?   @db.Uuid
  /// Google place id or cid - dedupe key
  placeKey       String    @db.VarChar(120)
  query          String?   @db.VarChar(300)
  title          String    @db.VarChar(300)
  category       String?   @db.VarChar(200)
  address        String?
  phone          String?   @db.VarChar(80)
  website        String?   @db.VarChar(500)
  emails         String?   @db.VarChar(1000)
  /// when the website was read for e-mail addresses, and what came out of it
  emailCheckedAt DateTime?
  emailNote      String?   @db.VarChar(200)
  rating         Decimal?  @db.Decimal(3, 2)
  reviewCount    Int?
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  mapsUrl        String?   @db.VarChar(1000)
  businessStatus String?   @db.VarChar(50)
  statusCode     String    @default("NEW") @db.VarChar(20) // lookup MAP_PLACE_STATUS
  leadId         String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([companyId, placeKey])
  @@index([companyId, statusCode])
  @@index([jobId])
  @@map("map_places")
}

// ----------------------------------------------------------------------------
// E-mail campaigns (marketing blasts)
// ----------------------------------------------------------------------------

model EmailCampaign {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  code             String    @db.VarChar(30)
  name             String    @db.VarChar(200)
  subject          String    @db.VarChar(300)
  /// HTML body with merge tags ({{name}}, {{company}}, ...)
  body             String
  fromName         String?   @db.VarChar(150)
  replyTo          String?   @db.VarChar(150)
  campaignId       String?   @db.Uuid // marketing campaign it belongs to
  /// audience definition: { source: LEADS|CUSTOMERS|MAP_PLACES|MANUAL, filters..., emails? }
  audience         Json
  /// AUTOMATIC: keeps adding new matching contacts and sends to them as they appear
  automatic        Boolean   @default(false)
  statusCode       String    @default("DRAFT") @db.VarChar(20) // lookup EMAIL_CAMPAIGN_STATUS
  scheduledAt      DateTime?
  startedAt        DateTime?
  finishedAt       DateTime?
  ratePerMinute    Int       @default(20)
  trackOpens       Boolean   @default(false)
  totalCount       Int       @default(0)
  sentCount        Int       @default(0)
  failedCount      Int       @default(0)
  openCount        Int       @default(0)
  unsubscribeCount Int       @default(0)
  replyCount       Int       @default(0)
  /// follow-ups are sent in office hours only (Mon-Fri 08:00-17:00, company time zone)
  followUpWeekdays Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdById      String?   @db.Uuid
  updatedById      String?   @db.Uuid
  deletedAt        DateTime?

  recipients EmailRecipient[]
  steps      EmailCampaignStep[]

  @@unique([companyId, code])
  @@index([companyId, statusCode])
  @@map("email_campaigns")
}

model EmailRecipient {
  id            String    @id @default(uuid()) @db.Uuid
  campaignId    String    @db.Uuid
  companyId     String    @db.Uuid
  email         String    @db.VarChar(200)
  name          String?   @db.VarChar(200)
  /// where the contact came from: LEAD / CUSTOMER / MAP_PLACE / MANUAL
  entityType    String?   @db.VarChar(20)
  entityId      String?   @db.Uuid
  /// merge data snapshot ({ name, company, city, ... })
  data          Json?
  statusCode    String    @default("QUEUED") @db.VarChar(20) // lookup EMAIL_RECIPIENT_STATUS
  /// random token for unsubscribe / open links
  token         String    @db.VarChar(64)
  error         String?   @db.VarChar(500)
  sentAt        DateTime?
  openedAt      DateTime?
  /// last e-mail of the sequence sent to this recipient (0 = the campaign e-mail, 1.. = follow-ups)
  step          Int       @default(0)
  lastSentAt    DateTime?
  /// Message-ID of the last e-mail, so the next follow-up continues the same thread
  lastMessageId String?   @db.VarChar(250)
  /// when the next follow-up is due (null = nothing more to send)
  nextSendAt    DateTime?
  repliedAt     DateTime?
  createdAt     DateTime  @default(now())

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, email])
  @@unique([token])
  @@index([campaignId, statusCode])
  @@index([campaignId, nextSendAt])
  @@index([companyId, email])
  @@map("email_recipients")
}

/// Follow-up e-mail of a campaign, sent when the recipient has not replied after the delay
model EmailCampaignStep {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  /// 1 = first follow-up
  position   Int
  /// days after the previous e-mail of the sequence
  delayDays  Int
  /// empty = "Re: <campaign subject>" in the same thread
  subject    String?  @db.VarChar(300)
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, position])
  @@map("email_campaign_steps")
}

/// One sent campaign e-mail (daily limit, thread matching of replies)
model EmailMessage {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  campaignId  String   @db.Uuid
  recipientId String   @db.Uuid
  step        Int      @default(0)
  messageId   String?  @db.VarChar(250)
  sentAt      DateTime @default(now())

  @@index([companyId, sentAt])
  @@index([campaignId, sentAt])
  @@index([messageId])
  @@map("email_messages")
}

/// A reply, automatic reply or bounce found in the mailbox for a campaign e-mail.
/// Only messages that belong to a campaign are stored, and only a short excerpt of them.
model EmailReply {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  campaignId  String?   @db.Uuid
  recipientId String?   @db.Uuid
  kindCode    String    @db.VarChar(20) // lookup EMAIL_REPLY_KIND
  fromEmail   String    @db.VarChar(200)
  fromName    String?   @db.VarChar(200)
  subject     String?   @db.VarChar(300)
  snippet     String?   @db.VarChar(600)
  messageId   String    @db.VarChar(250)
  receivedAt  DateTime
  handledAt   DateTime?
  handledById String?   @db.Uuid
  createdAt   DateTime  @default(now())

  @@unique([companyId, messageId])
  @@index([companyId, handledAt])
  @@index([campaignId])
  @@map("email_replies")
}

/// Where the reply check stopped in the mailbox of a company
model EmailInboxState {
  companyId     String    @id @db.Uuid
  uidValidity   String?   @db.VarChar(30)
  lastUid       Int       @default(0)
  lastCheckedAt DateTime?
  lastError     String?   @db.VarChar(500)
  lastErrorAt   DateTime?
  updatedAt     DateTime  @updatedAt

  @@map("email_inbox_states")
}

/// Addresses that must never receive marketing e-mail (unsubscribed, bounced, added by hand)
model EmailSuppression {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  email      String   @db.VarChar(200)
  reasonCode String   @db.VarChar(20) // lookup EMAIL_SUPPRESSION_REASON
  note       String?  @db.VarChar(300)
  campaignId String?  @db.Uuid
  createdAt  DateTime @default(now())

  @@unique([companyId, email])
  @@map("email_suppressions")
}

/// One block of the public website (karyaciptasolusi.com): a service, portfolio item, testimonial, FAQ, ...
/// The site reads the published blocks of one company through GET /public/website.
model WebContent {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  /// SERVICE | PORTFOLIO | TESTIMONIAL | FAQ | CLIENT | STAT | REASON | STEP | JOB
  section     String    @db.VarChar(20)
  title       String    @db.VarChar(200)
  subtitle    String?   @db.VarChar(200)
  body        String?
  icon        String?   @db.VarChar(50)
  imageUrl    String?   @db.VarChar(500)
  linkUrl     String?   @db.VarChar(500)
  tags        String?   @db.VarChar(500)
  value       String?   @db.VarChar(50)
  sortOrder   Int       @default(0)
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, section, sortOrder])
  @@map("web_contents")
}

/// Running announcement shown under the top bar of the application for everyone in the company
model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  message     String    @db.VarChar(500)
  /// INFO | SUCCESS | WARNING | URGENT
  tone        String    @default("INFO") @db.VarChar(20)
  linkUrl     String?   @db.VarChar(500)
  startsAt    DateTime?
  endsAt      DateTime?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, isActive])
  @@map("announcements")
}

/// Official company letter (recommendation, statement, assignment...) printed on the letterhead and signed
/// electronically by the system (QR verification)
model CompanyLetter {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  number         String    @db.VarChar(60)
  letterType     String    @db.VarChar(30)
  /// PERSON: signer + person details before the text; PLAIN: the text only (memo, invitation, minutes)
  layout         String    @default("PERSON") @db.VarChar(10)
  letterDate     DateTime  @db.Date
  subject        String    @db.VarChar(200)
  recipient      String?
  personName     String?   @db.VarChar(150)
  /// encrypted
  personIdNumber String?   @db.VarChar(255)
  /// encrypted
  personAddress  String?
  personPosition String?   @db.VarChar(150)
  body           String
  place          String    @db.VarChar(80)
  signerName     String    @db.VarChar(150)
  signerTitle    String    @db.VarChar(100)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  @@unique([companyId, number])
  @@map("company_letters")
}

/// A document text the director saved for reuse in the Document Center
model LetterTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  name        String    @db.VarChar(150)
  letterType  String    @db.VarChar(30)
  layout      String    @default("PERSON") @db.VarChar(10)
  subject     String    @db.VarChar(200)
  recipient   String?
  body        String
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, letterType])
  @@map("letter_templates")
}

/// Billing milestone (termin) of a client project: invoiced on its own, e.g. 30% down payment, 40% demo, 30% handover
model ProjectMilestone {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  projectId   String    @db.Uuid
  sortOrder   Int       @default(0)
  name        String    @db.VarChar(150)
  percent     Decimal?  @db.Decimal(5, 2)
  amount      Decimal   @db.Decimal(18, 2)
  dueDate     DateTime? @db.Date
  /// when it may be billed, e.g. "Setelah BAST ditandatangani"
  trigger     String?   @db.VarChar(200)
  invoiceId   String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String?   @db.Uuid
  updatedById String?   @db.Uuid
  deletedAt   DateTime?

  @@index([companyId, projectId])
  @@map("project_milestones")
}

/// UU 27/2022 (PDP): requests from data subjects (access, correction, deletion, ...) and how they were handled
model DataSubjectRequest {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  number         String    @db.VarChar(40)
  /// ACCESS | CORRECTION | DELETION | PORTABILITY | WITHDRAW_CONSENT | OBJECTION | RESTRICTION
  typeCode       String    @db.VarChar(30)
  requesterName  String    @db.VarChar(150)
  requesterEmail String?   @db.VarChar(150)
  /// the record the request is about: LEAD | CUSTOMER | EMPLOYEE | USER | OTHER
  subjectType    String    @db.VarChar(20)
  subjectId      String?   @db.Uuid
  receivedAt     DateTime  @default(now())
  dueAt          DateTime
  /// RECEIVED | VERIFYING | IN_PROGRESS | DONE | REJECTED
  statusCode     String    @default("RECEIVED") @db.VarChar(20)
  details        String?
  response       String?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

  @@unique([companyId, number])
  @@map("data_subject_requests")
}

/// UU 27/2022 (PDP): personal data breaches; data subjects and the authority are told within 3 x 24 hours
model DataBreach {
  id                  String    @id @default(uuid()) @db.Uuid
  companyId           String    @db.Uuid
  number              String    @db.VarChar(40)
  title               String    @db.VarChar(200)
  discoveredAt        DateTime
  notifyBy            DateTime
  /// what data and whose
  dataCategories      String?
  subjectsAffected    Int?
  cause               String?
  actionsTaken        String?
  /// LOW | MEDIUM | HIGH
  severityCode        String    @default("MEDIUM") @db.VarChar(10)
  /// OPEN | CONTAINED | NOTIFIED | CLOSED
  statusCode          String    @default("OPEN") @db.VarChar(20)
  subjectsNotifiedAt  DateTime?
  authorityNotifiedAt DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdById         String?   @db.Uuid
  updatedById         String?   @db.Uuid
  deletedAt           DateTime?

  @@unique([companyId, number])
  @@map("data_breaches")
}

/// Physical stock count (stock opname) of one warehouse; posting creates a confirmed stock adjustment for the differences
model StockCount {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  branchId     String?   @db.Uuid
  number       String    @db.VarChar(40)
  warehouseId  String    @db.Uuid
  countDate    DateTime  @db.Date
  /// COUNTING | POSTED | CANCELLED
  status       String    @default("COUNTING") @db.VarChar(20)
  /// people who counted and witnessed (printed on the berita acara)
  countedBy    String?   @db.VarChar(200)
  witnessedBy  String?   @db.VarChar(200)
  notes        String?
  adjustmentId String?   @db.Uuid
  postedAt     DateTime?
  postedById   String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdById  String?   @db.Uuid
  updatedById  String?   @db.Uuid
  deletedAt    DateTime?

  lines StockCountLine[]

  @@unique([companyId, number])
  @@map("stock_counts")
}

model StockCountLine {
  id         String    @id @default(uuid()) @db.Uuid
  countId    String    @db.Uuid
  productId  String    @db.Uuid
  /// book quantity when the count started, and when it was posted
  systemQty  Decimal   @db.Decimal(18, 4)
  countedQty Decimal?  @db.Decimal(18, 4)
  /// average cost at posting (values the difference)
  unitCost   Decimal   @default(0) @db.Decimal(18, 4)
  note       String?   @db.VarChar(300)
  countedAt  DateTime?

  count StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([countId, productId])
  @@map("stock_count_lines")
}

/// A credit note (sales return) or debit note (purchase return) settling part of an open invoice of the same partner
model CreditApplication {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @db.Uuid
  creditNoteId String   @db.Uuid
  invoiceId    String   @db.Uuid
  amount       Decimal  @db.Decimal(18, 2)
  date         DateTime @db.Date
  createdAt    DateTime @default(now())
  createdById  String?  @db.Uuid

  @@index([creditNoteId])
  @@index([invoiceId])
  @@map("credit_applications")
}

/// A batch / lot of a product (nomor bets) with its expiry date
model StockLot {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  productId       String    @db.Uuid
  lotNo           String    @db.VarChar(60)
  expiryDate      DateTime? @db.Date
  manufactureDate DateTime? @db.Date
  notes           String?   @db.VarChar(300)
  createdAt       DateTime  @default(now())

  balances LotBalance[]

  @@unique([companyId, productId, lotNo])
  @@index([companyId, expiryDate])
  @@map("stock_lots")
}

model LotBalance {
  id          String   @id @default(uuid()) @db.Uuid
  lotId       String   @db.Uuid
  warehouseId String   @db.Uuid
  qty         Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt

  lot StockLot @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@unique([lotId, warehouseId])
  @@map("lot_balances")
}

/// Which lots a document line moved (signed: + in, - out); used for reversal on cancel and for lot tracing / recalls
model LineLot {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String   @db.Uuid
  documentId  String   @db.Uuid
  lineId      String   @db.Uuid
  lotId       String   @db.Uuid
  warehouseId String   @db.Uuid
  qty         Decimal  @db.Decimal(18, 4)
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([lotId])
  @@index([lineId])
  @@map("line_lots")
}

/// Destruction of expired / damaged stock (pemusnahan): the stock adjustment plus the itemised berita acara
model StockDisposal {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  number          String   @db.VarChar(40)
  warehouseId     String   @db.Uuid
  date            DateTime @db.Date
  /// EXPIRED | DAMAGED | RECALL | OTHER
  reasonCode      String   @db.VarChar(20)
  method          String?  @db.VarChar(200)
  witnessedBy     String?  @db.VarChar(300)
  /// outside witness, e.g. the account representative of the tax office or a BPOM / Dinkes officer
  externalWitness String?  @db.VarChar(300)
  notes           String?
  adjustmentId    String?  @db.Uuid
  /// snapshot printed on the berita acara: code, name, lot, expiry, qty, unit cost, value
  lines           Json
  totalValue      Decimal  @default(0) @db.Decimal(18, 2)
  createdAt       DateTime @default(now())
  createdById     String?  @db.Uuid

  @@unique([companyId, number])
  @@map("stock_disposals")
}
