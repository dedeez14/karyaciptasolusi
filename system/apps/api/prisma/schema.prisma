  reconciledAt   DateTime?
  reconciledById String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid
  deletedAt      DateTime?

