# ---------------------------------------------------------------------------
# KCS ERP - API configuration. Copy to .env (scripts/init-env.mjs does it and
# generates strong random secrets automatically). NEVER commit the real .env.
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_NAME=KCS ERP
PORT=3000
# 127.0.0.1 = only this PC. Use 0.0.0.0 to allow other devices on your LAN (put HTTPS in front)
HOST=127.0.0.1
# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Runtime connection: least-privilege role (DML only)
DATABASE_URL=postgresql://kcs_app:CHANGE_ME@127.0.0.1:5432/kcs_erp?schema=public&connection_limit=20
# Migration connection: schema owner (DDL)
MIGRATION_DATABASE_URL=postgresql://kcs_owner:CHANGE_ME@127.0.0.1:5432/kcs_erp?schema=public
# Superuser used ONLY by `npm run db:setup` to create roles/database
PG_SUPERUSER_URL=postgresql://postgres@127.0.0.1:5432/postgres

# Secrets (base64, 32 bytes). Rotate by adding a new version, see docs/SECURITY.md
JWT_ACCESS_SECRET=
ENCRYPTION_KEY=
HMAC_KEY=
# Pepper mixed into every password hash (base64, 32 bytes). Never change it once users exist.
PASSWORD_PEPPER=

# Token lifetimes
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7

# File storage (outside the web root)
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Initial administrator (used by seed only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@karyaciptasolusi.com
SEED_ADMIN_PASSWORD=

# Public website (karyaciptasolusi.com): origins allowed to read /public/website (no cookies)
WEBSITE_ORIGINS=https://karyaciptasolusi.com,https://www.karyaciptasolusi.com
# Company code whose content the website shows (empty = oldest active company)
WEBSITE_COMPANY_CODE=

# Local development only: username signed in automatically when the app is opened on http://localhost
# (ignored for other addresses and behind a proxy; the server refuses to start with it when NODE_ENV=production)
DEV_AUTO_LOGIN=
